---
/* The one <head> on the site. Everything SEO-, social- and icon-related lives
   here so a change lands on all 85 pages at once.

   Audit 2026-09-14 fixed here: H-01 per-page descriptions, H-02 Open Graph +
   Twitter, H-03 canonical, H-06 icons + theme-color, M-07 skip link, L-02 lang. */
import "../styles/system.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { BRAND_FULL, DEFAULT_DESCRIPTION, OG_IMAGE } from "../data/site.ts";

interface Props {
  title?: string;
  /** Page-specific meta description. Falls back to the site default — but every
      page should pass its own; 85 identical descriptions was audit finding H-01. */
  description?: string;
  current?: string;
  /** Absolute-from-root path to a 1200x630 share image for this page. */
  image?: string;
  /** Keep a page out of search results (nothing uses this yet). */
  noindex?: boolean;
  /** JSON-LD object(s) for this page. Rendered as application/ld+json. */
  schema?: unknown;
}

const {
  title = BRAND_FULL,
  description = DEFAULT_DESCRIPTION,
  current,
  image = OG_IMAGE,
  noindex = false,
  schema,
} = Astro.props as Props;

/* Astro.site comes from `site` in astro.config.mjs. Building without it would
   silently emit relative canonicals, so fail loudly instead. */
if (!Astro.site) throw new Error("astro.config.mjs is missing `site` — canonical URLs and the sitemap need it.");

/* Canonical: the page's own path on the canonical host, without a query string
   or hash, and without a trailing slash (bar the root). */
const path = Astro.url.pathname.replace(/\/+$/, "") || "/";
const canonical = new URL(path, Astro.site).href;
const ogImage = new URL(image, Astro.site).href;

const schemaList = schema ? (Array.isArray(schema) ? schema : [schema]) : [];
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Icons. The files were already in public/ but nothing pointed at them
         before the 2026-09-14 audit (H-06). -->
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/brand/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#003249" />

    <!-- Open Graph — what WhatsApp, LinkedIn and email previews render. -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={BRAND_FULL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_GB" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700;800&family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;500;600&display=swap" />

    {schemaList.map((s) => (
      <script type="application/ld+json" set:html={JSON.stringify(s)} />
    ))}
  </head>
  <body>
    <a class="cx-skip" href="#main">Skip to content</a>
    <Header current={current} />
    <main id="main" tabindex="-1"><slot /></main>
    <Footer />
  </body>
</html>
