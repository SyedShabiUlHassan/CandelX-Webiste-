---
import Site from "../layouts/Site.astro";
import Section from "../components/ds/Section.astro";
import Eyebrow from "../components/ds/Eyebrow.astro";
import Icon from "../components/ds/Icon.astro";
import { BRAND, BRAND_FULL, FOUNDED, COUNTRIES, PRODUCT_FAMILIES, ARTICLE_NUMBERS, CONTACT, OG_IMAGE, DEFAULT_DESCRIPTION } from "../data/site.ts";

const capabilities = [
  ["layers", "Configurable inserts", "Silicone and stainless holders positioned to your instrument set, fixed at the base so nothing shifts in transit."],
  ["thermometer", "Built for the standard cycles", "Dimensioned and gasketed for the two programmes every department runs — 134 °C / 18 min and 121 °C / 30 min."],
  ["ruler", "DIN and custom sizes", "Full, three-quarter, half and quarter DIN as standard. Custom footprints from a drawing in 14 working days."],
];

// Part bands measured off the final hero frame: where each piece sits once
// separated. Rendered in markup rather than built in JS — elements created with
// createElement get no data-astro-cid attribute, so scoped CSS silently skips
// them and the labels lose position:absolute.
const heroParts = [
  { at: 0.059, side: "r", name: "Perforated lid", spec: "silicone gasket, replaceable filter", show: 0.26 },
  { at: 0.263, side: "l", name: "Filter discs",   spec: "single-use, 134 °C",                  show: 0.42 },
  { at: 0.467, side: "r", name: "Inner basket",   spec: "316L mesh",                           show: 0.58 },
  { at: 0.786, side: "l", name: "Base",           spec: "316L, laser-marked",                  show: 0.72 },
];

/* Every figure here must be one Hassan can evidence, or one counted from our own
   catalogue data. Nothing goes in this list without a source — audit 2026-09-14, B-05. */
const stats = [
  [FOUNDED, "Manufacturing since"],          // Hassan, 2026-09-14
  [COUNTRIES, "Countries shipped to"],       // Hassan, 2026-09-14
  [PRODUCT_FAMILIES, "Product families"],    // counted: src/data/catalogue.ts
  [ARTICLE_NUMBERS, "Article numbers"],      // counted: src/data/catalogue.ts
];

/* Organization + WebSite structured data (audit 2026-09-14, H-05).
   Every field is either a fact Hassan confirmed or something already on the
   page. Telephone, email and street address are emitted only once they exist
   in src/data/site.ts — an empty contactPoint is worse than none. */
const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    name: BRAND_FULL,
    alternateName: "CandelX",
    url: Astro.site!.href,
    logo: new URL("/brand/logo-candelx.png", Astro.site).href,
    image: new URL(OG_IMAGE, Astro.site).href,
    description: DEFAULT_DESCRIPTION,
    foundingDate: FOUNDED,
    address: {
      "@type": "PostalAddress",
      addressLocality: CONTACT.addressLocality,
      addressCountry: CONTACT.addressCountry,
      ...(CONTACT.streetAddress ? { streetAddress: CONTACT.streetAddress } : {}),
      ...(CONTACT.postalCode ? { postalCode: CONTACT.postalCode } : {}),
    },
    ...(CONTACT.telephone || CONTACT.email
      ? {
          contactPoint: {
            "@type": "ContactPoint",
            contactType: "sales",
            ...(CONTACT.telephone ? { telephone: CONTACT.telephone } : {}),
            ...(CONTACT.email ? { email: CONTACT.email } : {}),
          },
        }
      : {}),
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: BRAND_FULL,
    url: Astro.site!.href,
  },
];
---

<Site
  current="home"
  title={`Sterilization containers and instrument trays — ${BRAND}`}
  description="Stainless steel sterilization containers, perforated and wire mesh trays, and instrument cassettes from Sialkot. 304 and 316L, DIN and custom footprints, made to your instrument set."
  schema={schema}
>
  <!-- ===== Hero — pinned scroll-explode ===== -->
  <div class="hero-pin">
    <div class="hero-stage">
      <div class="cx-container hero-grid">
        <div class="hero-copy">
          <h1 class="hero-title"
            ><span class="ht-a">Trays that</span><br class="ht-br--m" /> <span class="ht-b">survive</span><br class="ht-br--d" /> <span class="ht-c">the</span><br class="ht-br--m" /> <span class="ht-d">cycle count</span></h1>
          <p class="hero-sub">316L containers that stay flat and sealed after years of daily autoclave cycles.</p>
          <a class="hero-link" href="/catalogue">See the range</a>
        </div>
        <div class="hero-slot" aria-hidden="true"></div>
      </div>
      <div class="hero-vis">
        <img class="hero-poster" src="/hero/f000.webp" width="560" height="1002" fetchpriority="high"
             alt="CandelX sterilization container with a teal perforated lid" />
        <canvas class="hero-canvas" width="560" height="1002" aria-hidden="true"></canvas>
      </div>
      <div class="hero-calls" aria-hidden="true">
        {heroParts.map((pt) => (
          <div class={`call call--${pt.side}`} data-at={pt.at} data-show={pt.show}>
            <span class="call__rule"></span>
            <span class="call__txt">
              <span class="call__name">{pt.name}</span>
              <span class="call__spec">{pt.spec}</span>
            </span>
          </div>
        ))}
      </div>
      <div class="hero-rail" aria-hidden="true">
        <span class="hero-rail__fill"></span><span class="hero-rail__lab">exploded view</span>
      </div>
      <div class="hero-cue" aria-hidden="true">
        <span class="hero-cue__t">scroll</span><span class="hero-cue__l"></span>
      </div>
    </div>
  </div>

  <!-- ===== Customize your tray (scroll) ===== -->
  <section class="tsteps" aria-label="How to customize your tray">
    <div class="tsteps__head">
      <p class="tsteps__kicker">How it works</p>
      <h2 class="tsteps__title">Customize your tray</h2>
    </div>
    <div class="tsteps__track">
      <div class="tsteps__spine" aria-hidden="true"></div>
      <ol class="tsteps__list">
        <li class="tstep"><span class="tstep__node" aria-hidden="true">1</span><div><h3>Select your tray</h3><p>Start from a DIN size or a blank footprint.</p></div></li>
        <li class="tstep"><span class="tstep__node" aria-hidden="true">2</span><div><h3>Define dimensions</h3><p>Length, width and depth, to the millimeter.</p></div></li>
        <li class="tstep"><span class="tstep__node" aria-hidden="true">3</span><div><h3>Choose material</h3><p>304 or 316L stainless, and the perforation pattern.</p></div></li>
        <li class="tstep"><span class="tstep__node" aria-hidden="true">4</span><div><h3>Refine the details</h3><p>Handles, feet, silicone inserts, laser marking.</p></div></li>
        <li class="tstep"><span class="tstep__node" aria-hidden="true">5</span><div><h3>Approve &amp; confirm</h3><p>Review the drawing and release it to production.</p></div></li>
      </ol>
    </div>
  </section>

  <!-- ===== Capabilities ===== -->
  <Section tone="card" pad={88}>
    <div class="band-head">
      <div>
        <Eyebrow>Capabilities</Eyebrow>
        <h2 class="cx-display-3" style="margin-top:16px">Built for the department that reprocesses it</h2>
      </div>
      <a href="/capabilities" style="font-size:13.5px;font-weight:500;white-space:nowrap">All capabilities</a>
    </div>
    <div class="cap-grid">
      {capabilities.map(([ic, t, d]) => (
        <div class="cap-cell">
          <div style="color:var(--brand-teal);margin-bottom:18px"><Icon name={ic} size={24} /></div>
          <h3 class="cx-h3">{t}</h3>
          <p style="margin-top:10px;font-size:13.5px;line-height:1.62;color:var(--text-muted)">{d}</p>
        </div>
      ))}
    </div>
  </Section>

  <!-- ===== Proof ===== -->
  <Section tone="inverse" pad={80}>
    <div class="proof-grid">
      {stats.map(([n, l]) => (
        <div>
          <div class="proof-n">{n}</div>
          <div class="proof-l">{l}</div>
        </div>
      ))}
    </div>
  </Section>
</Site>

<script>
  // ===== Hero scroll-explode =====
  // Frames are pre-rendered stills on a pure-white ground; multiply blending in CSS
  // makes that white read as transparent. See the CSS block above for the tunables.
  const pin = document.querySelector<HTMLElement>(".hero-pin");
  if (pin) {
    const stage  = pin.querySelector<HTMLElement>(".hero-stage")!;
    const grid   = pin.querySelector<HTMLElement>(".hero-grid")!;
    const copy   = pin.querySelector<HTMLElement>(".hero-copy")!;
    const slot   = pin.querySelector<HTMLElement>(".hero-slot")!;
    const vis    = pin.querySelector<HTMLElement>(".hero-vis")!;
    const canvas = pin.querySelector<HTMLCanvasElement>(".hero-canvas")!;
    const ctx    = canvas.getContext("2d");
    const calls  = pin.querySelector<HTMLElement>(".hero-calls")!;
    const rail   = pin.querySelector<HTMLElement>(".hero-rail")!;
    const railFill = pin.querySelector<HTMLElement>(".hero-rail__fill")!;
    const cue    = pin.querySelector<HTMLElement>(".hero-cue")!;
    const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;

    const COUNT = 144, CW = 560, CH = 1002;
    const FADE_END = 0.22;   // headline gone + tray centered by here
    const BLOW_END = 0.82;   // explode finished by here; it holds until 1
    const ARM_AT   = 16;     // start scrubbing once this many frames are in

    const clamp = (v: number, a: number, b: number) => (v < a ? a : v > b ? b : v);
    const lerp = (a: number, b: number, t: number) => a + (b - a) * t;
    const easeInOut = (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2);
    const easeIn = (t: number) => Math.pow(t, 1.8);

    const PARTS = [...calls.querySelectorAll<HTMLElement>(".call")].map((el) => ({
      at: parseFloat(el.dataset.at || "0"),
      show: parseFloat(el.dataset.show || "0"),
      side: el.classList.contains("call--r") ? "r" : "l",
      el,
      rule: el.querySelector<HTMLElement>(".call__rule")!,
    }));

    const frames: HTMLImageElement[] = [];
    let armed = false, last = -1;

    /* Frame loading, staged.
       All 144 frames used to be requested the instant the page parsed — 3.3 MB
       before the visitor had scrolled a pixel (audit 2026-09-14, H-08). Frame 0
       is already on screen as the poster, so only enough to start scrubbing is
       urgent; the rest arrive once the page is quiet or the visitor starts to
       scroll, whichever comes first. draw() already falls back to the newest
       frame that has arrived, so a part-loaded sequence scrubs correctly. */
    let loaded = 0;

    function load(i: number) {
      if (frames[i]) return;
      const img = new Image();
      img.decoding = "async";
      img.src = `/hero/f${String(i).padStart(3, "0")}.webp`;
      img.onload = img.onerror = () => {
        loaded++;
        if (!armed && loaded >= ARM_AT) {
          armed = true;
          vis.classList.add("is-ready");
          last = -1; draw();
        }
        /* The silhouette is read off the final frame specifically, not off
           "all of them" — it must not wait for the whole sequence. */
        if (i === COUNT - 1) { buildSil(); last = -1; draw(); }
      };
      frames[i] = img;
    }

    // Urgent: enough to arm the scrub, plus the last frame for the silhouette.
    for (let i = 0; i < ARM_AT; i++) load(i);
    load(COUNT - 1);

    // The remaining ~127 frames (about 3 MB) can wait.
    let restStarted = false;
    function loadRest() {
      if (restStarted) return;
      restStarted = true;
      for (let i = ARM_AT; i < COUNT - 1; i++) load(i);
    }
    addEventListener("scroll", loadRest, { passive: true, once: true });
    addEventListener("pointerdown", loadRest, { passive: true, once: true });

    /* On a metered or slow connection, 3 MB of frames the visitor may never
       scroll to is their money. Wait for a real scroll there; prefetch on idle
       only where bandwidth is cheap. */
    const conn = (navigator as any).connection;
    const thrifty = !!conn && (conn.saveData === true ||
      /^(slow-)?2g$|^3g$/.test(conn.effectiveType || ""));

    if (!thrifty) {
      if ("requestIdleCallback" in window) {
        (window as any).requestIdleCallback(loadRest, { timeout: 2500 });
      } else {
        setTimeout(loadRest, 1200);
      }
    }

    /* Where each part REALLY ends. Read once off the last frame: a per-row scan
       for the leftmost and rightmost non-white pixel. Without this the labels
       are placed against the frame box instead of the part, and three of the
       four sit on top of the metal. */
    let sil: Array<[number, number]> | null = null;
    function buildSil() {
      const im = frames[COUNT - 1];
      if (!im?.complete || !im.naturalWidth) return;
      const off = document.createElement("canvas");
      off.width = CW; off.height = CH;
      const oc = off.getContext("2d", { willReadFrequently: true });
      if (!oc) return;
      oc.drawImage(im, 0, 0, CW, CH);
      const d = oc.getImageData(0, 0, CW, CH).data;
      const rows: Array<[number, number]> = new Array(CH);
      for (let y = 0; y < CH; y++) {
        let lo = -1, hi = -1;
        const base = y * CW * 4;
        for (let x = 0; x < CW; x++) {
          const i = base + x * 4;
          if (d[i] < 247 || d[i + 1] < 247 || d[i + 2] < 247) { if (lo < 0) lo = x; hi = x; }
        }
        rows[y] = [lo, hi];
      }
      sil = rows;
    }
    // Widest point in a band around the part, so the label clears the whole piece
    // rather than the one row it happens to sit on.
    function edges(at: number): [number, number] {
      if (!sil) return [0.08, 0.92];
      const c = Math.round(at * CH);
      let lo = CW, hi = 0, n = 0;
      for (let y = Math.max(0, c - 26); y < Math.min(CH, c + 26); y++) {
        const r = sil[y];
        if (!r || r[0] < 0) continue;
        lo = Math.min(lo, r[0]); hi = Math.max(hi, r[1]); n++;
      }
      return n ? [lo / CW, hi / CW] : [0.08, 0.92];
    }

    function draw() {
      if (!ctx) return;
      const stickyTop = parseFloat(getComputedStyle(stage).top) || 0;
      const run = pin.offsetHeight - stage.offsetHeight;
      const p = reduce ? 1 : clamp((stickyTop - pin.getBoundingClientRect().top) / Math.max(run, 1), 0, 1);

      if (!reduce) {
        const raw = clamp(p / FADE_END, 0, 1);
        // --hero-travel is 0 below 820px: the tray stays in its resting slot and
        // scrolling goes straight into the explode (idea A, Hassan's call).
        const travel = parseFloat(getComputedStyle(pin).getPropertyValue("--hero-travel"));
        const move = travel === 0 ? 0 : easeInOut(raw);
        const fade = easeIn(raw);
        copy.style.opacity = String(1 - fade);
        copy.style.transform = `translateY(${(fade * -18).toFixed(1)}px)`;

        const sr = slot.getBoundingClientRect(), st = stage.getBoundingClientRect();
        const cs = getComputedStyle(pin);
        const nx = (parseFloat(cs.getPropertyValue("--hero-x")) || 0) / 100 * st.width;
        const ny = (parseFloat(cs.getPropertyValue("--hero-y")) || 0) / 100 * st.height;
        const dx0 = sr.left + sr.width / 2 - (st.left + st.width / 2) + nx;
        const dy0 = sr.top + sr.height / 2 - (st.top + st.height / 2) + ny;
        const s0 = sr.height / (vis.offsetHeight || 1);
        vis.style.transform = `translate(-50%,-50%) translate(${lerp(dx0, 0, move).toFixed(1)}px,` +
          `${lerp(dy0, 0, move).toFixed(1)}px) scale(${lerp(s0, 1, move).toFixed(4)})`;
      }

      const b = clamp((p - FADE_END) / Math.max(BLOW_END - FADE_END, 0.001), 0, 1);
      const fi = Math.round(b * (COUNT - 1));
      if (fi !== last) {
        // fall back to the newest frame that has actually arrived
        let img = frames[fi];
        if (!img?.complete || !img.naturalWidth) {
          for (let k = fi; k >= 0; k--) {
            if (frames[k]?.complete && frames[k].naturalWidth) { img = frames[k]; break; }
          }
        }
        if (img?.complete && img.naturalWidth) { ctx.drawImage(img, 0, 0, CW, CH); last = fi; }
      }

      // Callouts track the tray's live box, so they stay glued while it scales.
      const vr = vis.getBoundingClientRect(), sb = stage.getBoundingClientRect();
      calls.style.width = `${vr.width}px`;
      calls.style.height = `${vr.height}px`;
      calls.style.transform =
        `translate(-50%,-50%) translate(` +
        `${(vr.left + vr.width / 2 - (sb.left + sb.width / 2)).toFixed(1)}px,` +
        `${(vr.top + vr.height / 2 - (sb.top + sb.height / 2)).toFixed(1)}px)`;
      calls.classList.add("is-on");

      const narrow = matchMedia("(max-width: 820px)").matches;
      const gap = narrow ? 7 : 16;
      for (const pt of PARTS) {
        const [eL, eR] = edges(pt.at);
        pt.el.style.top = `${pt.at * vr.height}px`;
        pt.el.style.marginTop = "-14px";
        if (pt.side === "r") {
          pt.el.style.left = `${eR * vr.width + gap}px`;
          pt.el.style.right = "auto";
        } else {
          pt.el.style.right = `${(1 - eL) * vr.width + gap}px`;
          pt.el.style.left = "auto";
        }
        pt.rule.style.width = `${narrow ? 11 : 34}px`;
        pt.el.classList.toggle("is-in", b >= pt.show);
      }

      rail.classList.add("is-on");
      railFill.style.height = `${(p * 100).toFixed(1)}%`;
      cue.classList.toggle("is-on", p < 0.04);
    }

    let ticking = false;
    const onScroll = () => {
      if (!ticking) { ticking = true; requestAnimationFrame(() => { ticking = false; draw(); }); }
    };
    addEventListener("scroll", onScroll, { passive: true });
    addEventListener("resize", () => { last = -1; draw(); });
    // The resting spot is read off .hero-slot's live box, so anything that reflows it —
    // the 960px breakpoint flipping to one column, web fonts landing late — must redraw.
    if (window.ResizeObserver) {
      const ro = new ResizeObserver(() => { last = -1; draw(); });
      ro.observe(slot); ro.observe(grid);
    }
    document.fonts?.ready.then(() => { last = -1; draw(); });
    draw();
  }
</script>

<style>
  /* ===== Hero — pinned scroll-explode =====
     Chosen in _hero-scroll-lab.html. Scrolling holds the hero, fades the headline out,
     moves the tray to centre, then scrubs 144 frames of the explode and holds on the last.

     TO RETUNE, change these five numbers — that is what the lab's sliders drove:
       --hero-pin   how long the hero holds, in screen-heights
       --hero-rest  tray height before you scroll, in vh
       --hero-big   tray height once centered, in vh  (>94vh gets clipped by the stage)
       --hero-x/y   nudge the RESTING tray sideways / up-down, in % of the stage
     plus FADE_END and BLOW_END in the script below (fractions of the pinned run).

     Frames are /public/hero/f000..f143.webp — a pure-white background plus
     mix-blend-mode:multiply, so white reads as transparent and the dot grid shows
     through the tray and its mesh with no second mask file to download.
     Regenerate with ../scripts/hero-frames/. See DESIGN-DECISIONS.md */
  .hero-pin { --hero-pin: 2.4; --hero-rest: 90; --hero-big: 79; --hero-x: 0; --hero-y: -9;
    --hero-ar: 0.5589; --hero-bar: 46px; --hero-travel: 1;
    position: relative; height: calc(var(--hero-pin) * 100vh); background: var(--surface-card); }
  /* The dot grid sits on the STICKY stage, not the tall wrapper — on the wrapper it would
     scroll while the stage stayed put, so the dots would drift under a motionless tray. */
  .hero-stage { position: sticky; top: var(--hero-bar); height: calc(100vh - var(--hero-bar));
    overflow: hidden; display: flex; align-items: center; background: var(--surface-card); }
  .hero-stage::before { content: ""; position: absolute; inset: 0; pointer-events: none; z-index: 0;
    background: radial-gradient(circle at center, rgba(0, 50, 73, .16) 1.4px, transparent 1.9px) 0 0 / 16px 16px;
    opacity: .34; }
  .hero-grid { position: relative; z-index: 1; width: 100%;
    display: grid; grid-template-columns: 42% 1fr; gap: 64px; align-items: center; }
  .hero-copy { will-change: opacity, transform; }
  /* Invisible box that normal layout positions; the tray is measured against it, so the
     responsive rules below need no JS branch of their own. */
  .hero-slot { height: min(calc(var(--hero-rest) * 1vh), var(--hero-fit)); aspect-ratio: var(--hero-ar);
    margin: 0 auto; visibility: hidden; }
  /* A 9:16 frame sized only in vh overflows a narrow screen sideways, so clamp the
     height by the width actually available. */
  .hero-slot, .hero-vis { --hero-fit: calc((100vw - 2 * var(--gutter)) / var(--hero-ar)); }
  .hero-vis { position: absolute; left: 50%; top: 50%; z-index: 1;
    --h: min(calc(var(--hero-big) * 1vh), var(--hero-fit));
    height: var(--h); width: calc(var(--h) * var(--hero-ar));
    transform: translate(-50%, -50%); transform-origin: center center;
    will-change: transform; mix-blend-mode: multiply; }
  .hero-vis > * { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  .hero-canvas { opacity: 0; transition: opacity .25s ease; }
  .hero-vis.is-ready .hero-canvas { opacity: 1; }
  .hero-vis.is-ready .hero-poster { opacity: 0; }
  .hero-copy { display: flex; flex-direction: column; align-items: flex-start; }
  /* 64px + a 42% column, locked by Hassan 2026-09-14. See DESIGN-DECISIONS.md.
     At this pair "Trays that survive" needs 540px against a 477px column, so it
     breaks to three lines on purpose. 48% would give two clean lines instead. */
  .hero-title { font-family: var(--font-display); font-weight: var(--fw-black); font-size: 64px;
    line-height: 1.05; letter-spacing: -.022em; color: var(--text-strong); margin: 0; }
  /* One <h1>, two line-break patterns. Desktop reads "Trays that survive /
     the cycle count" with "the cycle count" teal. The phone (idea B, locked by
     Hassan 2026-09-14) reads "Trays that / survive the / cycle count" with only
     "cycle count" teal — a different break AND a different color boundary, so
     the words are split into four spans and the <br>s are switched per width.
     The space after each <br> is stripped when it starts a line and separates
     the words when the <br> is hidden, so one source serves both. */
  .hero-title .ht-br--m { display: none; }
  .hero-title .ht-c, .hero-title .ht-d { color: var(--brand-teal); }
  .hero-sub { font-size: 17px; line-height: 1.6; color: var(--text-body); margin: 22px 0 0; max-width: 40ch; }
  .hero-link { display: inline-block; margin-top: 30px; font-family: var(--font-sans); font-size: 14px;
    font-weight: var(--fw-semibold); color: var(--brand-teal); text-decoration: none;
    border-bottom: 1px solid var(--teal-100); padding-bottom: 3px; transition: color .2s ease, border-color .2s ease; }
  .hero-link:hover { color: var(--teal-700); border-bottom-color: var(--brand-teal); }
  /* ===== Part callouts — style 1, "measured leaders". Locked 2026-09-14.
     Each label is placed past that part's REAL silhouette edge, read off the
     pixels of the last frame. The previous build pinned every label to a fixed
     86% of the frame box, which put the lid label 50px INSIDE the lid, the base
     43px and the basket 32px — the four parts are simply not the same width.
     Verified: 16px clearance on all four, at 360/390/430/1280. ===== */
  .hero-calls { position: absolute; left: 50%; top: 50%; z-index: 6; pointer-events: none;
    opacity: 0; transition: opacity .3s ease; }
  .hero-calls.is-on { opacity: 1; }
  .call { position: absolute; display: flex; align-items: center;
    opacity: 0; transition: opacity .34s ease, transform .34s ease; }
  .call--r { flex-direction: row; transform: translateX(-12px); }
  .call--l { flex-direction: row-reverse; transform: translateX(12px); }
  .call.is-in { opacity: 1; transform: translateX(0); }
  .call__rule { height: 1px; background: var(--n-400); flex: none; position: relative; }
  .call__rule::after { content: ""; position: absolute; top: -2px; width: 5px; height: 5px;
    border-radius: 50%; background: var(--brand-teal); }
  .call--r .call__rule::after { left: 0; }
  .call--l .call__rule::after { right: 0; }
  .call__txt { white-space: nowrap; padding: 0 10px; }
  .call--l .call__txt { text-align: right; }
  .call__name { display: block; font-family: var(--font-sans); font-size: 13px;
    font-weight: var(--fw-semibold); color: var(--text-strong); line-height: 1.3; }
  .call__spec { display: block; font-family: var(--font-mono); font-size: 11px;
    color: var(--text-muted); line-height: 1.4; }

  /* Scroll progress rail + resting cue — both locked on. */
  .hero-rail { position: absolute; right: 26px; top: 50%; transform: translateY(-50%); z-index: 3;
    width: 1px; height: 140px; background: var(--border-hairline);
    opacity: 0; transition: opacity .3s ease; }
  .hero-rail.is-on { opacity: 1; }
  .hero-rail__fill { position: absolute; left: 0; top: 0; width: 1px; height: 0;
    background: var(--brand-teal); }
  .hero-rail__lab { position: absolute; right: 8px; top: 50%;
    transform: translateY(-50%) rotate(180deg); writing-mode: vertical-rl;
    font-family: var(--font-mono); font-size: 9px; letter-spacing: .18em;
    text-transform: uppercase; color: var(--text-faint); white-space: nowrap; }
  .hero-cue { position: absolute; left: 50%; bottom: 26px; transform: translateX(-50%); z-index: 3;
    display: flex; flex-direction: column; align-items: center; gap: 7px;
    opacity: 0; transition: opacity .3s ease; }
  .hero-cue.is-on { opacity: 1; }
  .hero-cue__t { font-family: var(--font-mono); font-size: 10px; letter-spacing: .18em;
    text-transform: uppercase; color: var(--text-faint); }
  .hero-cue__l { width: 1px; height: 34px;
    background: linear-gradient(var(--border-default), transparent); }

  .band-head { display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 48px; gap: 24px; }
  /* 3 columns since "Traceable to batch" was removed (2026-09-12, Hassan's instruction). */
  /* Left accent rule (chosen in _capability-line.html). The old version was a
     1px grid GAP with the background showing through, so the line ran the full
     height of the tallest column and text sat hard against it. */
  .cap-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 40px; }
  .cap-cell { padding-left: 22px; border-left: 2px solid var(--border-photo); }
  .proof-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 32px; }
  /* These carried inline font sizes, which no media query could reach — the
     labels stayed 11px on a phone however the breakpoint was written. */
  .proof-n { font-family: var(--font-display); font-weight: var(--fw-black); font-size: 44px;
    letter-spacing: -.02em; color: var(--white); line-height: 1; }
  .proof-l { margin-top: 12px; font-size: 11px; letter-spacing: .18em; text-transform: uppercase;
    font-weight: 600; color: rgba(255, 255, 255, .55); }
  @media (max-width: 960px) {
    .hero-grid { grid-template-columns: 1fr; gap: 28px; }
    .hero-title { font-size: 42px; }
    .hero-slot { height: min(calc(var(--hero-rest) * .62vh), var(--hero-fit)); }
    .cap-grid { grid-template-columns: 1fr 1fr; gap: 30px; }
    .proof-grid { grid-template-columns: 1fr 1fr; gap: 28px; }
  }

  /* ===== Phone + tablet-portrait hero — idea A, "stacked, explodes in place".
     Hassan, 2026-09-14: on a phone the tray must NOT travel to the centre first.
     --hero-travel:0 holds the tray in its resting slot, so scrolling goes
     straight into the explode, and the hold drops 2.4 -> 1.5 screens.
     The tray is 40vh rather than 52 because the measured leaders need side room:
     at 360px each label needs roughly 100px of margin. ===== */
  @media (max-width: 820px) {
    .hero-pin { --hero-pin: 1.5; --hero-rest: 40; --hero-big: 40;
      --hero-x: 0; --hero-y: 0; --hero-travel: 0; --hero-bar: 56px; }
    .hero-stage { align-items: flex-start; }
    .hero-grid { grid-template-columns: 1fr; gap: 0;
      align-items: start; align-content: start; padding-top: 4vh; }
    /* undo the 960px .62 shrink — the tray is sized by --hero-rest here */
    .hero-slot { height: min(calc(var(--hero-rest) * 1vh), var(--hero-fit)); margin-top: 18px; }
    .hero-title { font-size: 38px; line-height: 1.0; }
    .hero-title .ht-br--m { display: inline; }
    .hero-title .ht-br--d { display: none; }
    .hero-title .ht-c { color: var(--text-strong); }
    .hero-sub { font-size: 15px; margin-top: 14px; }
    .hero-link { margin-top: 18px; display: inline-flex; align-items: center; min-height: 44px; }
    /* No room for two lines of label beside a phone-width tray, so the spec
       drops and the name wraps. Name stays at the 12px mobile floor. */
    .call__txt { padding: 0 6px; white-space: normal; max-width: 80px; }
    .call__name { font-size: 12px; line-height: 1.25; }
    .call__spec { display: none; }
    .hero-rail { right: 12px; height: 100px; }
    .hero-rail__lab { display: none; }
    /* Nothing below the 12px reading floor on a phone. */
    .hero-cue__t { font-size: 12px; }
    .proof-l { font-size: 12px; letter-spacing: .14em; }
  }
  @media (max-width: 560px) {
    .cap-grid, .proof-grid { grid-template-columns: 1fr; }
  }

  /* No pinning, no scrub — a still hero. The headline must stay readable here,
     which the scroll code would otherwise have faded to nothing. */
  @media (prefers-reduced-motion: reduce) {
    .hero-pin { height: auto; }
    .hero-stage { position: static; height: auto; padding: 72px 0; }
    /* stays relative — the poster/canvas inside are absolutely positioned to it */
    .hero-vis { position: relative; left: auto; top: auto; transform: none; margin: 0 auto; }
    .hero-slot, .hero-calls, .hero-rail, .hero-cue { display: none; }
  }

  /* ===== Customize your tray — scroll section (Variant B: focus + recede) =====
     Chosen in _tray-steps-v2.html + _tray-b-colors.html. Template "Teal line": navy text, teal-600 line,
     teal-600 outline on the focused node. NO line track — the line only exists where you've scrolled
     (nothing ahead is revealed). Reveal is scroll-linked and reverses on scroll-up. See DESIGN-DECISIONS.md */
  .tsteps { background: var(--surface-card); padding: clamp(88px, 12vh, 128px) 32px clamp(112px, 16vh, 168px); }
  .tsteps__head { max-width: 940px; margin: 0 auto; }
  .tsteps__kicker { font-family: var(--font-sans); font-size: 11px; letter-spacing: .18em; text-transform: uppercase;
    font-weight: var(--fw-semibold); color: var(--brand-teal); margin: 0 0 14px; }
  .tsteps__title { font-family: var(--font-display); font-weight: var(--fw-bold); font-size: clamp(30px, 4vw, 40px);
    line-height: 1.06; letter-spacing: -.02em; color: var(--text-strong); margin: 0; }
  .tsteps__track { position: relative; max-width: 940px; margin: 96px auto 0; }
  .tsteps__spine { position: absolute; left: 50%; transform: translateX(-50%); top: 0; width: 2px; height: 0;
    background: var(--brand-teal); }
  .tsteps__list { list-style: none; padding: 0; margin: 0; position: relative; }
  .tstep { position: relative; width: 50%; opacity: 0; padding-bottom: clamp(132px, 30vh, 280px);
    transition: opacity .16s linear, transform .16s linear; }
  .tstep:last-child { padding-bottom: 0; }
  .tstep:nth-of-type(odd) { left: 0; text-align: right; padding-right: 60px; }
  .tstep:nth-of-type(even) { left: 50%; text-align: left; padding-left: 60px; }
  .tstep__node { position: absolute; top: -4px; width: 58px; height: 58px; border-radius: 50%; display: grid;
    place-items: center; font-family: var(--font-mono); font-size: 18px; background: var(--surface-card);
    border: 2px solid var(--border-default); color: var(--text-faint);
    transition: border-color .45s var(--ease-out), color .45s var(--ease-out), transform .45s var(--ease-out); }
  .tstep:nth-of-type(odd) .tstep__node { right: -29px; }
  .tstep:nth-of-type(even) .tstep__node { left: -29px; }
  .tstep h3 { font-family: var(--font-display); font-weight: var(--fw-bold); letter-spacing: -.015em; margin: 0;
    font-size: clamp(26px, 4.2vw, 38px); color: var(--text-strong); }
  .tstep p { font-family: var(--font-sans); color: var(--text-muted); margin: 12px 0 0; font-size: 18px; line-height: 1.6; }
  .tstep.is-hot .tstep__node { border-color: var(--brand-teal); color: var(--brand-teal); }
  /* Must sit AFTER the .tsteps__kicker base rule — same specificity, so source
     order decides, and the copy up in the hero block was being overridden. */
  @media (max-width: 820px) {
    .tsteps__kicker { font-size: 12px; }
  }
  /* Phone rail, rebuilt 2026-09-14. The old version positioned the node with
     left:-44px against the step's padding box, which put the badges at x = -12
     — hanging off the screen — and 39px away from the spine they belong on.
     Everything now derives from --railx so the node, the line and the text
     indent cannot drift apart. Gaps were 190px between five short steps, which
     made the section 1,827px tall on a phone; 8vh reads as a list instead. */
  @media (max-width: 680px) {
    .tsteps { padding: clamp(56px, 8vh, 80px) 20px clamp(64px, 9vh, 96px); }
    .tsteps__track { max-width: 520px; margin-top: 46px; --node: 34px; --railx: 17px; }
    .tsteps__spine { left: var(--railx); transform: translateX(-50%); }
    .tstep, .tstep:nth-of-type(odd), .tstep:nth-of-type(even) {
      width: auto; left: 0; text-align: left;
      padding: 0 0 clamp(48px, 8vh, 72px) calc(var(--railx) + var(--node) / 2 + 16px); }
    /* Node keeps left:0 and is centered on the rail with a margin — the scroll
       script writes transform on it, so transform cannot be used to position. */
    .tstep__node, .tstep:nth-of-type(odd) .tstep__node, .tstep:nth-of-type(even) .tstep__node {
      left: 0; right: auto; margin-left: calc(var(--railx) - var(--node) / 2);
      width: var(--node); height: var(--node); font-size: 13px; top: -1px; }
    .tstep h3 { font-size: 22px; }
    .tstep p { font-size: 15.5px; margin-top: 8px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .tstep { opacity: 1 !important; transform: none !important; }
    .tsteps__spine { height: 100% !important; }
  }
</style>

<script>
  const secs = document.querySelectorAll<HTMLElement>(".tsteps");
  if (secs.length) {
    const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
    const clamp = (v: number, a: number, b: number) => (v < a ? a : v > b ? b : v);
    let ticking = false;
    const frame = () => {
      ticking = false;
      const vh = window.innerHeight;
      secs.forEach((sec) => {
        const steps = [...sec.querySelectorAll<HTMLElement>(".tstep")];
        const track = sec.querySelector<HTMLElement>(".tsteps__track");
        const spine = sec.querySelector<HTMLElement>(".tsteps__spine");
        const mids = steps.map((s) => { const r = s.getBoundingClientRect(); return r.top + r.height / 2; });
        let hot = -1, best = Infinity;
        mids.forEach((m, i) => { const d = Math.abs(m - vh / 2); if (d < best) { best = d; hot = i; } });
        if (best > vh * 0.5) hot = -1; // nothing actually inside the reveal window yet — don't force one opaque
        steps.forEach((s, i) => {
          s.classList.toggle("is-hot", i === hot);
          if (reduce) return;
          const p = (mids[i] - vh / 2) / vh;
          const a = clamp((0.5 - Math.abs(p)) / (0.5 - 0.15), 0, 1);
          const isHot = i === hot;
          s.style.opacity = (isHot ? 1 : a * 0.6).toFixed(3);
          s.style.transform = `translateY(${(p * 24).toFixed(1)}px) scale(${isHot ? 1 : 0.93})`;
          const n = s.querySelector<HTMLElement>(".tstep__node");
          if (n) n.style.transform = `scale(${isHot ? 1.05 : 0.9})`;
        });
        if (track && spine) {
          const r = track.getBoundingClientRect();
          const pr = clamp((vh * 0.55 - r.top) / r.height, 0, 1);
          spine.style.height = (pr * 100).toFixed(2) + "%";
        }
      });
    };
    const onScroll = () => { if (!ticking) { ticking = true; requestAnimationFrame(frame); } };
    addEventListener("scroll", onScroll, { passive: true });
    addEventListener("resize", frame);
    frame();
  }
</script>
