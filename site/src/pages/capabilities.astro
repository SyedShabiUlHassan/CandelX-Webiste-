---
/* Capabilities — built to the design system's "Key Features" page archetype (Layout & Data Rules §1).
   This is the one archetype where bullet-style claims are permitted, because those bullets exist
   verbatim in the source catalogue's key_features[].bullets[]. See DESIGN-DECISIONS.md */
import Site from "../layouts/Site.astro";
import Section from "../components/ds/Section.astro";
import Eyebrow from "../components/ds/Eyebrow.astro";
import { TITLE_SUFFIX } from "../data/site.ts";

/* Headings read off the printed catalogue's own Key Features pages — not invented.
   The fuller bullet wording still to be lifted verbatim from catalogue/data/catalog-data.json;
   tracked in DESIGN-DECISIONS.md, NOT printed on the page (audit 2026-09-14, B-03). */
const features = [
  ["Material grades", "304 and 316L stainless to ASTM, sheet gauges from 0.8 to 1.2 mm."],
  ["Perforation patterns", "Square 6.4 × 6.4 mm and round patterns, on lid, bottom and sides."],
  ["Corner treatments", "Round corner and chamfer corner, each with its own article series."],
  ["Locking systems", "Four lock types across the cassette range, including bracket and round-click."],
  ["Silicon holding system", "Colour-coded strips and part sets for instrument retention."],
  ["Wire mesh construction", "Single frame and double frame protection, woven mesh base."],
];
---

<Site
  current="capabilities"
  title={`Manufacturing capability${TITLE_SUFFIX}`}
  description="What CandelX can manufacture: 304 and 316L stainless to ASTM, 0.8–1.2 mm sheet, square and round perforation, four cassette lock types and the silicon holding system."
>
  <Section class="cx-dotfield" pad={88}>
    <Eyebrow tone="accent">Key features</Eyebrow>
    <h1 class="cx-display-2" style="margin-top:16px;max-width:18ch">What we can make, and to what tolerance</h1>
    <p class="cx-body-lg" style="margin-top:20px;max-width:58ch;color:var(--text-body)">
      Manufacturing capability across the nine tray families, drawn from the key features pages of the
      printed catalogue.
    </p>
  </Section>

  <Section tone="card" pad={88}>
    <div class="kf">
      {features.map(([title, body], i) => (
        <div class="kf__i">
          <span class="kf__b">{String(i + 1).padStart(2, "0")}</span>
          <div>
            <h2 class="cx-h3">{title}</h2>
            <p class="cx-body-sm" style="margin-top:6px;color:var(--text-muted)">{body}</p>
          </div>
        </div>
      ))}
    </div>

  </Section>
</Site>

<style>
  .kf { display: grid; grid-template-columns: 1fr 1fr; gap: var(--s-10) var(--s-12); }
  .kf__i { display: flex; gap: var(--s-4); align-items: flex-start; }
  .kf__b { flex: none; width: 26px; height: 26px; border-radius: var(--r-pill);
    background: var(--surface-accent); color: var(--brand-teal); display: grid; place-items: center;
    font-family: var(--font-mono); font-size: var(--t-label-size); font-weight: var(--fw-semibold); }
  @media (max-width: 820px) {
    .kf { grid-template-columns: 1fr; gap: var(--s-8); }
    .kf__b { font-size: 12px; }   /* was 11px — below the phone reading floor */
  }
</style>
