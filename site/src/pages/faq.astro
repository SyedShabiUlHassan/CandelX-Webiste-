---
/* FAQ.
 *
 * Content lives in src/data/faq.ts. A question with no answer written is NOT
 * published — it appears only on the dev server, flagged, and is absent from
 * both the production HTML and the FAQPage structured data. The 2026-09-14
 * audit found three pages printing placeholder notes to customers (B-03); this
 * makes that impossible here rather than relying on remembering.
 *
 * Built on <details>/<summary>, so it opens and closes with no JavaScript, is
 * keyboard-operable for free, and browser find-in-page reaches closed answers.
 */
import Site from "../layouts/Site.astro";
import Section from "../components/ds/Section.astro";
import Eyebrow from "../components/ds/Eyebrow.astro";
import Button from "../components/ds/Button.astro";
import Icon from "../components/ds/Icon.astro";
import { faq, answered, unanswered, answeredCount, totalCount } from "../data/faq.ts";
import { BRAND, TITLE_SUFFIX } from "../data/site.ts";

const isDev = import.meta.env.DEV;

/* In dev, show every question so the page can be reviewed whole. In the build,
   only the ones with answers. */
const groups = isDev ? faq : answered;

/* FAQPage rich results — answered questions only. An empty answer in schema is
   a structured-data error, and Google will drop the whole block for it. */
const schema = answered.length
  ? {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      mainEntity: answered.flatMap((g) =>
        g.items.map((i) => ({
          "@type": "Question",
          name: i.q,
          acceptedAnswer: { "@type": "Answer", text: i.a },
        })),
      ),
    }
  : undefined;
---

<Site
  title={`Frequently asked questions${TITLE_SUFFIX}`}
  description="Ordering, custom tray footprints, 304 vs 316L, DIN sizes, certifications, shipping and payment — the questions buyers ask CandelX most often."
  schema={schema}
>
  <Section pad={72}>
    <Eyebrow>Questions</Eyebrow>
    <h1 class="cx-display-3" style="margin-top:16px">Frequently asked</h1>
    <p class="cx-body-lg faq-lede">
      The questions that come up in almost every enquiry. If yours isn't here,
      ask us directly — a real answer beats a guess.
    </p>

    {isDev && unanswered.length > 0 && (
      <div class="faq-dev">
        <p class="faq-dev__t">
          Dev only · {answeredCount} of {totalCount} answered
        </p>
        <p class="faq-dev__b">
          The {unanswered.length} questions marked below are <strong>not in the production
          build</strong> and not in the structured data. Write their answers in{" "}
          <span class="cx-mono">src/data/faq.ts</span> and they appear. This panel never ships.
        </p>
      </div>
    )}

    <nav class="faq-jump" aria-label="Sections">
      {groups.map((g) => <a href={`#${g.id}`}>{g.title}</a>)}
    </nav>

    {groups.map((g) => (
      <section class="faq-g" id={g.id}>
        <div class="faq-g__head">
          <h2 class="cx-h2">{g.title}</h2>
          <p class="faq-g__blurb">{g.blurb}</p>
        </div>

        <div class="faq-list">
          {g.items.map((i) => {
            const pending = !i.a.trim();
            return (
              <details class={pending ? "faq-i faq-i--pending" : "faq-i"} open={!pending && false}>
                <summary>
                  <span class="faq-q">{i.q}</span>
                  {pending && <span class="faq-flag">Needs your answer</span>}
                  <span class="faq-chev" aria-hidden="true"><Icon name="arrow-right" size={14} /></span>
                </summary>
                <div class="faq-a">
                  {pending
                    ? <p class="faq-a__pending">Not published. Write this answer in{" "}<span class="cx-mono">src/data/faq.ts</span>.</p>
                    : <p>{i.a}</p>}
                </div>
              </details>
            );
          })}
        </div>
      </section>
    ))}

    <div class="faq-cta">
      <div>
        <h2 class="cx-h3">Didn't find it?</h2>
        <p class="faq-cta__b">
          Send us the article numbers and quantities and we'll come back with a quotation,
          a lead time and the packing detail. Anything you're unsure of, we'll ask.
        </p>
      </div>
      <div class="faq-cta__btns">
        <Button href="/quote">Request a quote</Button>
        <a class="faq-cta__link" href="/support">Contact {BRAND}</a>
      </div>
    </div>
  </Section>
</Site>

<style>
  .faq-lede { margin-top: 18px; max-width: 54ch; color: var(--text-body); }

  /* Dev-only banner. Never reaches a build — see the isDev guard above. */
  .faq-dev { margin-top: var(--s-8); padding: 16px 20px; max-width: 72ch;
    border: 1px dashed var(--border-default); border-radius: var(--r-2);
    background: var(--surface-accent); }
  .faq-dev__t { margin: 0; font-family: var(--font-mono); font-size: 11px;
    letter-spacing: .12em; text-transform: uppercase; color: var(--brand-teal);
    font-weight: var(--fw-semibold); }
  .faq-dev__b { margin: 7px 0 0; font-size: 13.5px; color: var(--text-body); }

  /* Jump links */
  .faq-jump { display: flex; flex-wrap: wrap; gap: 8px; margin-top: var(--s-9);
    padding-bottom: var(--s-8); border-bottom: 1px solid var(--border-hairline); }
  .faq-jump a { display: inline-flex; align-items: center; min-height: 38px;
    padding: 0 15px; border: 1px solid var(--border-hairline); border-radius: var(--r-pill);
    font-size: 13.5px; color: var(--text-body); background: var(--surface-card); }
  .faq-jump a:hover { border-color: var(--brand-teal); color: var(--text-strong); }

  /* Groups */
  .faq-g { margin-top: var(--s-11); scroll-margin-top: 80px; }
  .faq-g__head { max-width: 60ch; }
  .faq-g__blurb { margin: 7px 0 0; font-size: 14.5px; color: var(--text-muted); }
  .faq-list { margin-top: var(--s-6); max-width: 78ch;
    border-top: 1px solid var(--border-hairline); }

  /* One question. <details> so it works with JS off. */
  .faq-i { border-bottom: 1px solid var(--border-hairline); }
  .faq-i summary {
    display: flex; align-items: center; gap: var(--s-4);
    min-height: 60px; padding: 14px 4px; cursor: pointer;
    list-style: none; /* Firefox */
  }
  .faq-i summary::-webkit-details-marker { display: none; }
  .faq-i summary:hover .faq-q { color: var(--brand-teal); }
  .faq-i summary:focus-visible { outline: 2px solid var(--brand-teal); outline-offset: -2px; border-radius: var(--r-1); }
  .faq-q { flex: 1; font-family: var(--font-sans); font-size: 15.5px;
    font-weight: var(--fw-medium); color: var(--text-strong); line-height: 1.45; }
  .faq-chev { flex: none; display: inline-flex; color: var(--text-faint);
    transition: transform .22s var(--ease-out), color .22s ease; transform: rotate(90deg); }
  .faq-i[open] .faq-chev { transform: rotate(-90deg); color: var(--brand-teal); }

  .faq-a { padding: 0 4px 20px; max-width: 66ch; }
  .faq-a p { margin: 0; font-size: 15px; line-height: 1.7; color: var(--text-body); }

  /* Pending — dev only, but styled so it is unmistakable on sight. */
  .faq-i--pending .faq-q { color: var(--text-muted); }
  .faq-flag { flex: none; font-family: var(--font-mono); font-size: 10px;
    letter-spacing: .1em; text-transform: uppercase; font-weight: var(--fw-semibold);
    padding: 4px 9px; border-radius: var(--r-1);
    background: var(--surface-accent); color: var(--brand-teal); }
  .faq-a__pending { color: var(--text-muted) !important; font-size: 13.5px !important; }

  /* Closing CTA */
  .faq-cta { margin-top: var(--s-12); padding-top: var(--s-9);
    border-top: 1px solid var(--border-hairline);
    display: flex; align-items: flex-end; justify-content: space-between;
    gap: var(--s-8); flex-wrap: wrap; }
  .faq-cta__b { margin: 9px 0 0; max-width: 52ch; font-size: 14.5px; color: var(--text-muted); }
  .faq-cta__btns { display: flex; align-items: center; gap: var(--s-6); flex: none; }
  .faq-cta__link { display: inline-flex; align-items: center; min-height: 44px; font-size: 14.5px; }

  @media (prefers-reduced-motion: reduce) { .faq-chev { transition: none; } }

  @media (max-width: 820px) {
    .faq-jump a { min-height: 44px; }
    .faq-i summary { padding: 16px 2px; }
    .faq-cta { flex-direction: column; align-items: stretch; }
    .faq-cta__btns { width: 100%; }
  }
</style>
