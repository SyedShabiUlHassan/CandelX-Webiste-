---
import Site from "../layouts/Site.astro";
import Section from "../components/ds/Section.astro";
import Eyebrow from "../components/ds/Eyebrow.astro";
import Icon from "../components/ds/Icon.astro";
import { families, sections, imageDims } from "../data/catalogue.ts";
import { TITLE_SUFFIX } from "../data/site.ts";

const totalSkus = families.reduce((n, f) => n + f.sizes.length, 0);

/* Measured pixel size, so the 79 cards reserve their boxes before the photos
   arrive and the grid does not reflow as you scroll — audit M-06. */
const dimsOf = (src: string | null | undefined) => {
  const d = src ? imageDims[src] : undefined;
  return d ? { width: d[0], height: d[1] } : {};
};

const cards = families.map((f) => ({
  slug: f.slug,
  name: f.name,
  subtitle: f.subtitle,
  section: f.section,
  prefix: f.prefix,
  count: f.sizes.length,
  image: f.image,
  /* Split so the search can rank: an exact name match must beat a product that
     merely mentions the term in its description (audit 2026-09-14, M-12). */
  nameKey: f.name.toLowerCase(),
  skuKey: [f.prefix, ...f.sizes.map((s) => s.sku)].join(" ").toLowerCase(),
  search: [f.name, f.prefix, f.subtitle, f.section, f.summary, ...f.sizes.map((s) => s.sku)].join(" ").toLowerCase(),
}));

const sectionCounts = sections.map((s) => ({
  name: s,
  n: families.filter((f) => f.section === s).length,
}));
---

<Site
  current="products"
  title={`Product catalogue${TITLE_SUFFIX}`}
  description={`Browse all ${families.length} CandelX product families and ${totalSkus} article numbers — wire mesh trays, perforated trays, cassettes, hollow ware and the silicon holding system.`}
>
  <Section pad={64}>
    <Eyebrow>Catalogue</Eyebrow>
    <h1 class="cx-display-3" style="margin-top:16px">Sterilization containers and trays</h1>
    <p class="cat-lede">{families.length} product families · {totalSkus} article numbers across {sections.length} sections.</p>

    <div class="cat-grid">
      <aside class="cat-side">
        <label class="cx-field">
          <span class="cx-field__label">Search</span>
          <span class="cx-field__box">
            <span style="color:var(--text-faint);display:inline-flex"><Icon name="search" size={15} /></span>
            <input type="text" class="mono" placeholder="Name or article no.…" data-cat-search />
          </span>
        </label>

        <div>
          <Eyebrow>Section</Eyebrow>
          <div class="cat-secs">
            {sectionCounts.map((s) => (
              <label class="cat-sec">
                <input type="checkbox" data-section={s.name} />
                <span>{s.name}</span>
                <span class="cat-sec__n">{s.n}</span>
              </label>
            ))}
          </div>
        </div>
      </aside>

      <div>
        <div class="cat-count"><span class="mono-count" data-count>{cards.length} of {cards.length} families</span></div>
        <div class="cat-cards" data-cards>
          {cards.map((c) => (
            <a
              class="cx-card cx-card--interactive cx-card--p0 cat-card"
              href={`/catalogue/${c.slug}`}
              data-section={c.section}
              data-search={c.search}
              data-name={c.nameKey}
              data-sku={c.skuKey}
            >
              {c.image ? (
                <span class="cat-card__ph"><img src={c.image} alt={`${c.name} — ${c.section}`} {...dimsOf(c.image)} loading="lazy" decoding="async" /></span>
              ) : (
                <span class="cat-card__ph cat-card__ph--empty"><span>Photo to follow</span></span>
              )}
              <span class="cat-card__body">
                <span class="cat-card__sec">{c.section}</span>
                <span class="cat-card__name">{c.name}</span>
                {c.subtitle && <span class="cat-card__sub">{c.subtitle}</span>}
                <span class="cat-card__foot">
                  <span>{c.count} {c.count === 1 ? "size" : "sizes"}</span>
                  <span class="mono">{c.prefix}</span>
                </span>
              </span>
            </a>
          ))}
        </div>
        <p class="cat-empty" data-empty hidden>No families match. Clear a filter or the search.</p>
      </div>
    </div>
  </Section>
</Site>

<style>
  .cat-lede { margin-top: 14px; font-size: 14px; color: var(--text-muted); }
  .cat-grid { display: grid; grid-template-columns: 248px 1fr; gap: 48px; margin-top: 44px; align-items: start; }
  .cat-side { display: flex; flex-direction: column; gap: 26px; position: sticky; top: 62px; }
  .cat-secs { display: flex; flex-direction: column; gap: 2px; margin-top: 12px; }
  .cat-sec { display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 9px;
    font-size: 13px; color: var(--text-body); padding: 5px 0; cursor: pointer; }
  .cat-sec input { accent-color: var(--brand-teal); }
  .cat-sec__n { font-family: var(--font-mono); font-size: 11px; color: var(--text-faint); }

  .cat-count { margin-bottom: 20px; }
  .mono-count { font-family: var(--font-mono); font-size: 12.5px; color: var(--text-muted); }
  .cat-cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; }

  .cat-card { display: flex; flex-direction: column; overflow: hidden; }
  /* The photo area must be the SAME white as the card. The product shots carry
     their own white, so a sunken tint drew a third shade behind them. */
  .cat-card__ph { display: block; aspect-ratio: 4 / 3; background: var(--surface-card);
    border-bottom: 1px solid var(--border-photo);
    border-radius: var(--r-2) var(--r-2) 0 0; overflow: hidden; }
  .cat-card__ph img { width: 100%; height: 100%; object-fit: contain; }
  .cat-card__ph--empty { display: grid; place-items: center; }
  .cat-card__ph--empty span { font-family: var(--font-mono); font-size: 10px; letter-spacing: .12em;
    text-transform: uppercase; color: var(--text-faint); }
  .cat-card__body { padding: 16px 18px 18px; display: flex; flex-direction: column; gap: 5px; flex: 1; }
  .cat-card__sec { font-size: 10px; letter-spacing: .13em; text-transform: uppercase; font-weight: var(--fw-semibold); color: var(--text-muted); }
  .cat-card__name { font-family: var(--font-display); font-weight: var(--fw-semibold); font-size: 15.5px;
    letter-spacing: -.01em; color: var(--text-strong); line-height: 1.3; }
  .cat-card__sub { font-size: 12.5px; line-height: 1.45; color: var(--text-muted);
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .cat-card__foot { margin-top: auto; padding-top: 12px; display: flex; justify-content: space-between;
    font-family: var(--font-mono); font-size: 11.5px; color: var(--text-muted); }
  .cx-card[hidden] { display: none; }
  .cat-empty { margin-top: 8px; font-size: 13px; color: var(--text-muted); }

  @media (max-width: 1040px) { .cat-cards { grid-template-columns: repeat(2, 1fr); } }

  /* ===== Phone + tablet portrait — idea B, "index rows". Approved by Hassan
     2026-09-14; see DESIGN-DECISIONS.md.  The photo grid ran 79 cards x ~355px =
     33,958px, or 43.5 phone screens.  Each product becomes one scannable row
     with a small thumbnail, the way a parts catalogue reads: ~8,300px, 76%
     shorter, and still every product on one page. ===== */
  @media (max-width: 820px) {
    /* A one-column grid is minmax(auto,1fr), so a card wider than the screen
       drags the whole column — and the sidebar — past the viewport. */
    .cat-grid { grid-template-columns: minmax(0, 1fr); }
    .cat-side { position: static; }
    .cat-cards, .cat-card { min-width: 0; }

    .cat-cards { display: block; }
    .cat-card { flex-direction: row; align-items: center; gap: 12px;
      padding: 9px 2px; border-bottom: 1px solid var(--border-hairline); }
    .cat-card__ph { flex: none; width: 56px; height: 56px; aspect-ratio: auto;
      border-radius: var(--r-3); border-bottom: none; overflow: hidden; }
    .cat-card__ph--empty span { font-size: 8px; letter-spacing: .06em; }
    .cat-card__body { padding: 0; gap: 1px; justify-content: center; min-width: 0; }
    .cat-card__sec { font-size: 12px; letter-spacing: .1em; }
    .cat-card__name { font-size: 14px; line-height: 1.3;
      white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .cat-card__sub { display: none; }
    .cat-card__foot { margin: 0; padding: 0; flex: none; align-self: center;
      border: none; font-size: 12px; color: var(--text-faint); }

    /* Search field was 271x18 with zero padding; the box now has a real target
       and 16px text so iOS does not zoom the page on focus. */
    .cat-side .cx-field__box { padding: 10px 12px; }
    .cat-side .cx-field__box input { min-height: 40px; font-size: 16px; }

    /* Filters were 13x13 checkboxes inside 31px rows. */
    .cat-sec { min-height: 44px; padding: 0 4px; }
    .cat-sec input[type="checkbox"] { width: 24px; height: 24px; }
    .cat-sec .cat-sec__n, .mono-count { font-size: 12px; }
  }
</style>

<script>
  const cards = [...document.querySelectorAll<HTMLElement>("[data-cards] .cx-card")];
  const secBoxes = [...document.querySelectorAll<HTMLInputElement>('input[data-section]')];
  const search = document.querySelector<HTMLInputElement>("[data-cat-search]");
  const countEl = document.querySelector<HTMLElement>("[data-count]");
  const emptyEl = document.querySelector<HTMLElement>("[data-empty]");
  const total = cards.length;

  const container = document.querySelector<HTMLElement>("[data-cards]");
  /* Remember the printed order so clearing the search restores it exactly. */
  const naturalOrder = new Map(cards.map((c, i) => [c, i]));

  /* How well a card matches. Higher sorts first.
     Before the audit the search had no ranking at all, so searching "kidney"
     put "Kidney dish" LAST, behind four products that merely mention kidney
     dishes in their descriptions (M-12). */
  function score(card: HTMLElement, q: string): number {
    const name = card.getAttribute("data-name") || "";
    const sku = card.getAttribute("data-sku") || "";
    const all = card.getAttribute("data-search") || "";
    if (!q) return 0;
    if (name === q) return 100;                       // exact product name
    if (name.startsWith(q)) return 80;                // name begins with it
    if (new RegExp(`\\b${q.replace(/[.*+?^${}()|[\]\\]/g, "\\$&")}`).test(name)) return 60; // word in the name
    if (name.includes(q)) return 50;                  // anywhere in the name
    if (sku.includes(q)) return 40;                   // an article number
    if (all.includes(q)) return 10;                   // description or section
    return -1;                                        // no match
  }

  function apply() {
    const q = (search?.value || "").trim().toLowerCase();
    const active = secBoxes.filter((b) => b.checked).map((b) => b.getAttribute("data-section"));
    let shown = 0;
    const ranked: { card: HTMLElement; s: number }[] = [];

    for (const card of cards) {
      const secOk = active.length === 0 || active.includes(card.getAttribute("data-section"));
      const s = score(card, q);
      const visible = secOk && (!q || s >= 0);
      card.hidden = !visible;
      if (visible) { shown++; ranked.push({ card, s }); }
    }

    /* Reorder only while searching; an empty box restores the catalogue order. */
    if (container) {
      ranked.sort((a, b) =>
        b.s - a.s || (naturalOrder.get(a.card)! - naturalOrder.get(b.card)!));
      for (const { card } of ranked) container.appendChild(card);
    }

    if (countEl) countEl.textContent = `${shown} of ${total} families`;
    if (emptyEl) emptyEl.hidden = shown !== 0;
  }

  secBoxes.forEach((b) => b.addEventListener("change", apply));
  search?.addEventListener("input", apply);

  /* Deep links from the footer: /catalogue?section=Cassette%20Trays lands with
     that section already ticked (audit 2026-09-14, H-12). Repeatable, so
     ?section=A&section=B works too. */
  const wanted = new URLSearchParams(location.search).getAll("section");
  if (wanted.length) {
    let matched = false;
    for (const b of secBoxes) {
      if (wanted.includes(b.getAttribute("data-section") || "")) { b.checked = true; matched = true; }
    }
    if (matched) {
      apply();
      document.querySelector("[data-cards]")?.scrollIntoView({ block: "start", behavior: "instant" as ScrollBehavior });
    }
  }
</script>
