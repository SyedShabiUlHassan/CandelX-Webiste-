---
import Site from "../../layouts/Site.astro";
import Section from "../../components/ds/Section.astro";
import Badge from "../../components/ds/Badge.astro";
import Button from "../../components/ds/Button.astro";
import Photo from "../../components/ds/Photo.astro";
import Icon from "../../components/ds/Icon.astro";
import SpecTable from "../../components/ds/SpecTable.astro";
import CatalogueDrawer from "../../components/CatalogueDrawer.astro";
import RelatedProducts from "../../components/RelatedProducts.astro";
import { families, imageDims } from "../../data/catalogue.ts";
import { BRAND, BRAND_FULL, TITLE_SUFFIX_SHORT } from "../../data/site.ts";

export function getStaticPaths() {
  return families.map((f) => ({ params: { slug: f.slug }, props: { fam: f } }));
}
const { fam } = Astro.props;

/* Real pixel size for an image, measured from its own file header at build
   time (src/data/catalogue.ts → imageDims). Spread onto an <img> so the browser
   reserves the right box and nothing jumps as photos load — audit M-06.
   Returns {} for an image we could not measure, so the tag stays valid. */
function dimsOf(src: string | null | undefined): { width?: number; height?: number } {
  const d = src ? imageDims[src] : undefined;
  return d ? { width: d[0], height: d[1] } : {};
}
type Size = (typeof fam.sizes)[number];

/* Rows shown before "Show all". Hassan: the sizes panel must stay small and sit
   beside the photo — three rows, the rest behind the expander. */
const LIMIT = 3;

const SPEC_LABEL: Record<string, string> = {
  material: "Material",
  steel_sheet: "Steel sheet",
  sheet: "Steel sheet",
  perforation: "Perforation",
  mesh_type: "Mesh",
  mesh: "Mesh",
};
const specRows = Object.entries(fam.specs).map(([k, v]) => ({
  label: SPEC_LABEL[k] ?? k.replace(/_/g, " ").replace(/^\w/, (c) => c.toUpperCase()),
  value: v,
  plain: true,
}));

function dims(s: Size) {
  if (s.L && s.W && s.H) return `${s.L} × ${s.W} × ${s.H} mm`;
  if (s.L && s.W) return `${s.L} × ${s.W} mm`;
  return s.sizeText || s.raw || "—";
}

/** Does this row carry an actual measurement, as opposed to a placeholder? */
function hasDim(s: Size) {
  return dims(s) !== "—";
}

const variants = fam.variants ?? [];

type Col = { code: string; label: string };
type PivotRow = { dims: string; note: string | null; cells: Record<string, string | null> };
type Table = {
  label: string | null;
  pivot: boolean;
  cols: Col[];
  rows: Size[];
  pivotRows: PivotRow[];
  hasLid: boolean;
  hasNote: boolean;
  /** False when NOT ONE row in this table carries a measurement. The Dimensions
      column is then dropped entirely rather than printing a stack of em dashes —
      Hassan, 2026-09-14 (audit M-01): "remove the column where I have not
      uploaded any size and add size on request". */
  hasDims: boolean;
};

function buildTables(sizes: Size[], groupLabel: string | null): Table[] {
  if (!sizes.length) return [];
  const cols = variants.filter((v) => sizes.some((s) => s.variant === v.code));

  let pivot = false;
  if (cols.length > 1) {
    const keys = new Set(sizes.map(dims));
    const shared = [...keys].filter((k) =>
      cols.every((v) => sizes.some((s) => s.variant === v.code && dims(s) === k))
    ).length;
    pivot = keys.size > 0 && shared / keys.size >= 0.5;
  }

  if (pivot) {
    const order: string[] = [];
    const byKey = new Map<string, PivotRow>();
    for (const s of sizes) {
      const k = dims(s);
      if (!byKey.has(k)) {
        order.push(k);
        byKey.set(k, { dims: k, note: null, cells: {} });
      }
      const row = byKey.get(k)!;
      row.cells[s.variant] = s.sku;
      if (!row.note && s.note) row.note = s.note;
    }
    const pivotRows = order.map((k) => byKey.get(k)!);
    return [{
      label: groupLabel, pivot: true, cols, rows: [], pivotRows,
      hasLid: false, hasNote: pivotRows.some((r) => r.note),
      hasDims: pivotRows.some((r) => r.dims !== "—"),
    }];
  }

  if (cols.length > 1) {
    return cols.map((v) => {
      const rows = sizes.filter((s) => s.variant === v.code);
      return {
        label: groupLabel ? `${groupLabel} — ${v.label}` : v.label,
        pivot: false, cols, rows, pivotRows: [],
        hasLid: rows.some((s) => s.lid), hasNote: rows.some((s) => s.note),
        hasDims: rows.some(hasDim),
      };
    }).filter((t) => t.rows.length > 0);
  }

  return [{
    label: groupLabel, pivot: false, cols, rows: sizes, pivotRows: [],
    hasLid: sizes.some((s) => s.lid), hasNote: sizes.some((s) => s.note),
    hasDims: sizes.some(hasDim),
  }];
}

function tablesFor(sizes: Size[]): Table[] {
  /* Lids are printed under their own heading in the catalogue — keep them out of
     the tray table, where a heightless row reads like a duplicate size. */
  return [
    ...buildTables(sizes.filter((s) => !s.isLid), null),
    ...buildTables(sizes.filter((s) => s.isLid), "Lids (optional)"),
  ];
}

/* Pages that print each variant as its own block (transportation baskets:
   Steel / Aluminum; bur holders: four families) show those separately. */
/* A set whose members are separate products (PRF surgical set): each gets its
   own block in a grid, and the page carries no single hero photo — the
   instruments themselves are the picture. */
const instruments = fam.groupLayout === "instruments";
const grouped = !instruments && fam.groups.length > 1;
const tables = grouped ? [] : tablesFor(fam.sizes);
const groupBlocks: { label: string; images: string[]; tables: Table[] }[] = [];

/* The panel shows LIMIT rows in total. A family with a tray table AND a lid
   table was applying the limit to each, so six rows appeared instead of three. */
/* True when at least one table on this page publishes a measurement. When it is
   false the panel drops the unit label and says sizes are made to order, rather
   than printing a column of em dashes — audit M-01. */
let rowCursor = 0;
const panelTables = tables.map((t) => {
  const offset = rowCursor;
  rowCursor += t.pivot ? t.pivotRows.length : t.rows.length;
  return { ...t, offset };
});
const panelRows = rowCursor;

/* Does this product publish any measurement at all? 47 of 79 did not, and each
   printed a column of em dashes — audit M-01. */
const anyDims = panelTables.some((t) => t.hasDims);

/* "Sizes 40" was counting article numbers. A perforated tray is 20 sizes in two
   corner patterns, not 40 sizes; a light pattern cassette is 4 sizes in four
   lock types, not 18. 34 of 79 products overstated it this way — Hassan,
   2026-09-15. The header now counts distinct measurements and names the
   article-number total beside it, so neither number is a guess. */
const sizeCount = new Set(fam.sizes.map(dims).filter((d) => d !== "—")).size;
const artCount = fam.sizes.length;

/* images[] when the product carries a full set; the old image/imageAlt pair
   otherwise. Guarded so a non-path can never reach an <img>. */
/* A multi-block page printed its blocks' photos again at the top — the same
   picture twice on one page, on 10 of the 11 such pages. Hassan verified the
   list on 2026-09-15 and asked for the repeats gone. Anything a block below
   already carries comes out of the hero rather than the hero being deleted
   wholesale: the steel-mirror page has ten shots up top and only one of them is
   a repeat, and the other nine exist nowhere else. */
const groupShots = new Set<string>(grouped ? fam.groups.flatMap((g) => g.images) : []);
let mainShots: string[] = ((fam as any).images?.length
  ? (fam as any).images
  : [fam.image, fam.imageAlt]
)
  .filter((s: unknown): s is string => typeof s === "string" && s.startsWith("/"))
  .filter((s: string) => !groupShots.has(s));

/* Every photo on the page belongs to a block, so dropping the repeats left the
   top with no photo at all — and a one-column text intro that looked nothing
   like the other 78 pages (Hassan, 2026-09-15: "you removed the duplicate but
   changed the layout entirely").

   So the hero borrows instead: it takes the lead photo of the first block that
   has one to spare, and that block stops showing it. The block keeps the rest,
   the page keeps the layout every other product has, and the photo still
   appears exactly once. */
let borrowed: string | null = null;
if (!instruments && grouped && mainShots.length === 0) {
  const donor = fam.groups.find((g) => g.images.length > 1);
  if (donor) {
    borrowed = donor.images[0];
    mainShots = [borrowed];
  } else if (fam.groups[0]?.images.length) {
    /* No block can spare one — every block here is a single photo and a single
       article number. Taking it would leave a block with an empty frame, which
       is worse than the one repeat, so the hero shares it. */
    mainShots = [fam.groups[0].images[0]];
  }
}

/* Only if the product has no photography at all. */
const heroless = !instruments && mainShots.length === 0;

if (grouped) {
  for (const g of fam.groups) {
    groupBlocks.push({
      label: g.label,
      images: g.images.filter((src) => src !== borrowed),
      tables: tablesFor(g.sizes as Size[]),
    });
  }
}

const pages = fam.sourcePages;
const pageRange = pages.length
  ? (pages.length === 1 ? `page ${pages[0]}` : `pages ${pages[0]}–${pages[pages.length - 1]}`)
  : "";

/* ── Metadata ──────────────────────────────────────────────────────────────
   Audit 2026-09-14:
   H-01 — all 85 pages shared one meta description. Each family already carries
          a 14–26 word summary, so the description writes itself from the data.
   M-04 — the long suffix pushed eight titles past the ~60 characters Google
          shows, so product pages use the short one.
   H-05 — Product + BreadcrumbList JSON-LD, the highest-value SEO addition for
          a 79-product catalogue. Every value below is read from the catalogue
          data; nothing is asserted that the page does not already show. */
const skuCount = fam.sizes.length;
/* The Material value is sometimes a grade ("304 (ASTM)") and sometimes already a
   material name ("Stainless steel", "Glass"), so only the bare grades get the
   word "stainless" appended — otherwise it reads "Stainless steel stainless". */
const material = fam.specs.Material?.trim() ?? "";
const materialPhrase = /^3\d\d\s*\(/.test(material) ? `${material} stainless` : material;

const metaDescription = [
  fam.summary,
  `${skuCount} article number${skuCount === 1 ? "" : "s"}`,
  materialPhrase || null,
].filter(Boolean).join(" · ") + ` — from ${BRAND}.`;

const canonicalUrl = new URL(`/catalogue/${fam.slug}`, Astro.site).href;

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Product",
    name: fam.name,
    description: fam.summary,
    sku: fam.prefixes?.[0] ?? fam.prefix,
    category: fam.section,
    url: canonicalUrl,
    brand: { "@type": "Brand", name: BRAND_FULL },
    manufacturer: { "@type": "Organization", name: BRAND_FULL },
    ...(fam.image ? { image: new URL(fam.image, Astro.site).href } : {}),
    ...(Object.keys(fam.specs).length
      ? {
          additionalProperty: Object.entries(fam.specs).map(([name, value]) => ({
            "@type": "PropertyValue", name, value,
          })),
        }
      : {}),
    /* Quote-only: no price is published, so availability is the honest signal
       and the "offer" points at the enquiry form, not a checkout. */
    offers: {
      "@type": "Offer",
      url: new URL("/quote", Astro.site).href,
      availability: "https://schema.org/InStock",
      priceCurrency: "USD",
      priceSpecification: {
        "@type": "PriceSpecification",
        valueAddedTaxIncluded: false,
      },
      seller: { "@type": "Organization", name: BRAND_FULL },
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: new URL("/", Astro.site).href },
      { "@type": "ListItem", position: 2, name: "Catalogue", item: new URL("/catalogue", Astro.site).href },
      { "@type": "ListItem", position: 3, name: fam.name, item: canonicalUrl },
    ],
  },
];
---

<Site
  current="products"
  title={`${fam.name}${TITLE_SUFFIX_SHORT}`}
  description={metaDescription}
  image={fam.image ?? undefined}
  schema={schema}
  footer={false}
>
  <Section pad={36}>
    <div class="pd-top">
      <a href="/catalogue" class="pd-back">
        <Icon name="arrow-left" size={14} /> Catalogue
      </a>
      {/* Left-edge ☰ above 820px, an inline pill here below it. */}
      <CatalogueDrawer current={fam.slug} />
    </div>

    <div class={instruments || heroless ? "pd-grid pd-grid--intro" : "pd-grid"}>
      {!instruments && !heroless && (
      <div class={fam.details.length ? "pd-media pd-media--thumbs" : "pd-media"}>
        {mainShots.length > 0 ? (
          <div class="pd-slider" data-slider>
            <figure class="pd-figure pd-figure--zoom" data-zoom>
              {mainShots.map((src, i) => (
                <img src={src} alt={fam.name} {...dimsOf(src)} loading={i === 0 ? "eager" : "lazy"} decoding={i === 0 ? "sync" : "async"} fetchpriority={i === 0 ? "high" : undefined} data-shot hidden={i !== 0} />
              ))}
            </figure>
            {mainShots.length > 1 && (
              <div class="pd-nav">
                <button class="pd-arrow" type="button" data-prev aria-label="Previous photo">
                  <Icon name="arrow-left" size={15} />
                </button>
                <div class="pd-dots">
                  {mainShots.map((_, i) => (
                    <button class="pd-dot" type="button" data-dot aria-label={`Photo ${i + 1} of ${mainShots.length}`} />
                  ))}
                </div>
                <button class="pd-arrow" type="button" data-next aria-label="Next photo">
                  <Icon name="arrow-right" size={15} />
                </button>
              </div>
            )}
          </div>
        ) : (
          <Photo label="Product photography — to be supplied" ratio="4 / 3" />
        )}

        {fam.summary && <p class="pd-summary">{fam.summary}</p>}

        {/* Hidden by default and revealed by the script below only when the file
            is genuinely bigger than the box it is drawn in. 34 products have a
            photo under 340x250, where "click to enlarge" promised detail that
            does not exist (audit 2026-09-14, M-08). */}
        {mainShots.length > 0 && (
          <p class="pd-zoomhint" data-zoomhint hidden>
            <Icon name="search" size={13} /> Click the photo to enlarge — technical drawings carry printed dimensions
          </p>
        )}

        {fam.details.length > 0 && (
          <div class="pd-thumbs">
            {fam.details.map((d) => (
              <figure class="pd-thumb">
                <img src={d.src} alt={d.caption || ""} {...dimsOf(d.src)} loading="lazy" decoding="async" />
                {d.caption && <figcaption>{d.caption}</figcaption>}
              </figure>
            ))}
          </div>
        )}
      </div>
      )}

      <div>
        <div class="pd-meta">
          <Badge tone="accent">{fam.section}</Badge>
          <span class="pd-prefix">{fam.prefix}</span>
        </div>
        <h1 class="cx-display-3 pd-title">{fam.name}</h1>
        {fam.subtitle && <p class="pd-subtitle">{fam.subtitle}</p>}
        {(instruments || heroless) && fam.summary && <p class="pd-summary">{fam.summary}</p>}

        {specRows.length > 0 && (
          <div class="pd-specs"><SpecTable rows={specRows} /></div>
        )}

        {!instruments && !grouped && (
        <div class="pd-panel" data-sizes>
          <div class="pd-panel__head">
            <h2>{anyDims ? "Sizes" : "Article numbers"}</h2>
            <span class="pd-panel__n">{anyDims ? sizeCount : artCount}</span>
            {anyDims && artCount > sizeCount && (
              <span class="pd-panel__also">{artCount} article numbers</span>
            )}
            {anyDims && <span class="pd-panel__unit">L × W × H mm</span>}
          </div>
            {panelTables.map((t) => (
              <div class={t.offset >= LIMIT ? "pd-sizes pd-row--extra" : "pd-sizes"}>
                {t.label && <h3 class={t.offset >= LIMIT ? "pd-h3 pd-row--extra" : "pd-h3"}>{t.label}</h3>}
                <div class="pd-tablewrap">
                  <table class="pd-table">
                    <thead>
                      <tr>
                        {/* Numbered down the left so a long list can be read off
                            and referred to — Hassan, 2026-09-15. */}
                        <th class="pd-idx"><span class="pd-sr">Row</span></th>
                        {t.pivot ? (
                          <>
                            {t.hasDims && <th>Dimensions</th>}
                            {t.cols.map((v) => <th>{v.label}</th>)}
                            {t.hasNote && <th>Notes</th>}
                          </>
                        ) : (
                          <>
                            <th>Article no.</th>
                            {t.hasDims && <th>Dimensions</th>}
                            {t.hasLid && <th>Lid</th>}
                            {t.hasNote && <th>Notes</th>}
                          </>
                        )}
                      </tr>
                    </thead>
                    <tbody>
                      {t.pivot
                        ? t.pivotRows.map((r, i) => (
                            <tr class={t.offset + i >= LIMIT ? "pd-row--extra" : undefined}>
                              <td class="pd-idx">{i + 1}</td>
                              {t.hasDims && <td class="mono">{r.dims}</td>}
                              {t.cols.map((v) => <td class="mono">{r.cells[v.code] || "—"}</td>)}
                              {t.hasNote && <td>{r.note || ""}</td>}
                            </tr>
                          ))
                        : t.rows.map((s, i) => (
                            <tr class={t.offset + i >= LIMIT ? "pd-row--extra" : undefined}>
                              <td class="pd-idx">{i + 1}</td>
                              <td class="mono">
                                {s.sku}
                              </td>
                              {t.hasDims && <td class="mono">{dims(s)}</td>}
                              {t.hasLid && <td>{s.lid || ""}</td>}
                              {t.hasNote && <td>{s.note || ""}</td>}
                            </tr>
                          ))}
                    </tbody>
                  </table>
                </div>
              </div>
            ))}
            {anyDims
              ? <p class="pd-note pd-row--extra">Further sizes are manufactured to order — ask us for anything not listed.</p>
              : <p class="pd-note">Sizes on request. Tell us your instrument set or send a drawing and we will confirm dimensions with the quotation.</p>}
          {/* "Show all 16 sizes" on a product with four sizes and sixteen article
              numbers was the same overstatement as the panel header. */}
          {panelRows > LIMIT && (
            <button class="pd-more" type="button" data-more
              data-label={`Show all ${panelRows} ${panelRows === sizeCount ? "sizes" : "article numbers"}`}>
              Show all {panelRows} {panelRows === sizeCount ? "sizes" : "article numbers"}
            </button>
          )}
        </div>
        )}
        {/* The fine print sits beside the button, not under it: stacked, it
            was the last 30px that pushed the tallest pages past the fold. */}
        <div class="pd-cta">
          <Button href={`/quote?add=${fam.slug}`} size="lg">Request a quote</Button>
          <p class="pd-onrequest">
            Mass, load ratings, validation reports and material certificates are available on request.
          </p>
        </div>
      </div>
    </div>

    {instruments && (
      <div class={`pd-block pd-inst${fam.slug === "prf-surgical-set" ? " pd-inst--tall" : ""}`}>
        <h2 class="pd-h2">
          Instruments in the set<span class="pd-count">{fam.groups.length}</span>
        </h2>
        <div class="pd-inst__grid">
          {fam.groups.map((g) => (
            <figure class="pd-inst__item">
              <div class="pd-inst__frame">
                <img src={g.images[0]} alt={g.label} {...dimsOf(g.images[0])} loading="lazy" decoding="async" />
              </div>
              <figcaption>
                {g.label !== g.code && <h3 class="pd-inst__name">{g.label}</h3>}
                <span class="pd-inst__code">{g.code}</span>
                {g.note && <span class="pd-inst__note">{g.note}</span>}
              </figcaption>
            </figure>
          ))}
        </div>
        <p class="pd-note">
          Each instrument is supplied individually or as the complete set — quote by article number.
        </p>
      </div>
    )}

    {!instruments && grouped
      ? groupBlocks.map((g) => (
          <div class="pd-block pd-group">
            <h2 class="pd-h2">{g.label}</h2>
            <div class="pd-group__grid">
              {g.images.length > 0 && (
                <div class="pd-slider pd-slider--sm" data-slider>
                  <figure class="pd-figure">
                    {g.images.map((src, i) => (
                      <img src={src} alt={g.label} {...dimsOf(src)} loading="lazy" decoding="async" data-shot hidden={i !== 0} />
                    ))}
                  </figure>
                  {g.images.length > 1 && (
                    <div class="pd-nav">
                      <button class="pd-arrow" type="button" data-prev aria-label="Previous photo">
                        <Icon name="arrow-left" size={14} />
                      </button>
                      <div class="pd-dots">
                        {g.images.map((_, i) => (
                          <button class="pd-dot" type="button" data-dot aria-label={`Photo ${i + 1}`} />
                        ))}
                      </div>
                      <button class="pd-arrow" type="button" data-next aria-label="Next photo">
                        <Icon name="arrow-right" size={14} />
                      </button>
                    </div>
                  )}
                </div>
              )}
              <div>
                {g.tables.map((t) => (
                  <div class="pd-sizes" data-sizes>
                    {t.label && <h3 class="pd-h3">{t.label}</h3>}
                    <div class="pd-tablewrap">
                      <table class="pd-table">
                        <thead>
                          <tr>
                            <th class="pd-idx"><span class="pd-sr">Row</span></th>
                            <th>Article no.</th>
                            <th>Dimensions</th>
                            {t.hasLid && <th>Lid</th>}
                            {t.hasNote && <th>Notes</th>}
                          </tr>
                        </thead>
                        <tbody>
                          {t.rows.map((s, i) => (
                            <tr class={i >= LIMIT ? "pd-row--extra" : undefined}>
                              <td class="pd-idx">{i + 1}</td>
                              <td class="mono">{s.sku}</td>
                              <td class="mono">{dims(s)}</td>
                              {t.hasLid && <td>{s.lid || ""}</td>}
                              {t.hasNote && <td>{s.note || ""}</td>}
                            </tr>
                          ))}
                        </tbody>
                      </table>
                    </div>
                    {t.rows.length > LIMIT && (
                      <button class="pd-more" type="button" data-more data-label={`Show all ${t.rows.length} sizes`}>
                        Show all {t.rows.length} sizes
                      </button>
                    )}
                  </div>
                ))}
              </div>
            </div>
          </div>
        ))
      : null}

  </Section>

  {/* Product pages end here, on the rest of the section, instead of on the site
      footer — Hassan, 2026-09-15. */}
  <RelatedProducts current={fam.slug} />

  <div class="pd-lightbox" data-lightbox hidden>
    <button class="pd-lightbox__close" type="button" data-close aria-label="Close">
      <Icon name="x" size={18} />
    </button>
    <img data-lightbox-img alt="" decoding="async" />
    <span class="pd-lightbox__scale" data-scale></span>
  </div>
</Site>

<style is:global>
  /* Product pages run on pure white: the photo's own white then blends
     into the page instead of showing as a lighter box. */
  body { background: var(--surface-card); }
</style>

<style>
  .pd-top { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; }
  .pd-back { font-size: 13px; border: none; display: inline-flex; align-items: center; gap: 7px; color: var(--text-muted); }
  .pd-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 48px; margin-top: 20px; align-items: start; }
  /* A grid item defaults to min-width:auto, so a wide sizes table grew its own
     track past the container and dragged the whole page sideways on a phone —
     24 of 79 product pages, worst case +107px at 375px (audit 2026-09-14, H-07).
     min-width:0 lets the track shrink so .pd-tablewrap scrolls instead. */
  .pd-grid > *,
  .pd-group__grid > *,
  .pd-thumbs > *,
  .pd-inst__grid > * { min-width: 0; }

  /* Main photo. The catalogue prints the same tray in two sizes, or two corner
     patterns, as equal main shots — both belong here, not in the thumbnails. */
  /* ONE frame size on every product. It used to take the photo's own aspect
     ratio, which — once a max-height was added to keep the page on one screen —
     made the whole box shrink rather than letterbox: a portrait photo drew a
     292px frame in a 544px column, next to products drawing the full 544.
     Hassan, 2026-09-15: "this product photo is very small and it doesn't
     resemble the layout of other products."

     `aspect-ratio` + `max-height` is the trap. With the ratio set and no
     definite width, a clamped height pulls the width down with it. A fixed
     height and a full-width box cannot do that, and every product page now
     draws an identical frame. Nothing is cropped — the image is still
     object-fit:contain inside it. vh so a taller window gets a bigger photo;
     the px ceiling stops it becoming a billboard on a 27" display. */
  .pd-figure { margin: 0; border: 1px solid var(--border-photo); border-radius: var(--r-2);
    overflow: hidden; background: var(--surface-card); padding: 18px;
    width: 100%; height: min(56vh, 448px);
    display: flex; align-items: center; justify-content: center; }
  .pd-figure img { width: 100%; height: 100%; object-fit: contain; }
  .pd-figure img[hidden] { display: none; }
  .pd-figure--zoom { cursor: zoom-in; }
  .pd-zoomhint { display: inline-flex; align-items: center; gap: 6px; margin: 8px 0 0;
    font-size: 12px; color: var(--text-faint); }
  .pd-zoomhint svg { flex: none; }

  /* Full-screen view. The drawings are 2000–3100px wide and carry printed
     dimensions that are unreadable at column width. */
  .pd-lightbox[hidden] { display: none; }
  .pd-lightbox { position: fixed; inset: 0; z-index: 200; background: rgba(0, 25, 35, .92);
    display: flex; align-items: center; justify-content: center; padding: 40px; cursor: zoom-out;
    overflow: auto; }
  .pd-lightbox img { max-width: 100%; max-height: 100%; width: auto; height: auto;
    object-fit: contain; background: var(--surface-card); border-radius: var(--r-2);
    cursor: zoom-in; }
  /* Second click: native size, panned by scrolling — this is what makes the
     printed dimensions on the mirror drawings legible. */
  .pd-lightbox.is-full { align-items: flex-start; justify-content: flex-start; cursor: default; }
  .pd-lightbox.is-full img { max-width: none; max-height: none; width: auto; cursor: zoom-out; margin: auto; }
  .pd-lightbox__scale { position: fixed; bottom: 20px; left: 50%; transform: translateX(-50%);
    font-family: var(--font-mono); font-size: 12px; color: rgba(255,255,255,.75);
    background: rgba(0,0,0,.35); border-radius: 999px; padding: 6px 14px; pointer-events: none; }
  .pd-lightbox__close { position: fixed; top: 20px; right: 22px; width: 38px; height: 38px;
    display: inline-flex; align-items: center; justify-content: center; cursor: pointer;
    border: 1px solid rgba(255,255,255,.25); border-radius: 50%; background: none; color: #fff; }
  .pd-lightbox__close:hover { border-color: #fff; }

  .pd-nav { display: flex; align-items: center; justify-content: center; gap: 14px; margin-top: 10px; }
  .pd-arrow { display: inline-flex; align-items: center; justify-content: center; width: 32px; height: 32px;
    border: 1px solid var(--border-default); border-radius: 50%; background: none; color: var(--text-muted);
    cursor: pointer; transition: border-color var(--dur-2) var(--ease-out), color var(--dur-2) var(--ease-out); }
  .pd-arrow:hover { border-color: var(--brand-teal); color: var(--brand-teal); }
  .pd-dots { display: flex; gap: 7px; }
  .pd-dot { width: 7px; height: 7px; padding: 0; border-radius: 50%; border: none; cursor: pointer;
    background: var(--border-default); transition: background var(--dur-2) var(--ease-out); }
  .pd-dot.is-on { background: var(--brand-teal); }

  /* Captioned detail shots, as printed ("Easy to lock"). Products whose page
     carries no captioned figures get no strip at all. */
  /* Always five tracks, however many captioned shots the page carries: the
     strip is then one row on every product (five used to wrap to two) and every
     thumbnail is the same size from page to page. */
  .pd-thumbs { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 10px; margin-top: 6px; }
  .pd-thumb { margin: 0; }
  /* Fixed height rather than a 4:3 ratio: the strip then costs the same on
     every page and can be budgeted against the fold. */
  .pd-thumb img { width: 100%; height: 68px; object-fit: contain;
    background: var(--surface-card); border: 1px solid var(--border-photo);
    border-radius: var(--r-1); padding: 6px; }
  /* Two lines then an ellipsis — one long printed caption used to set the
     height of the whole row. */
  .pd-thumb figcaption { margin-top: 4px; font-size: 10.5px; line-height: 1.25; color: var(--text-muted);
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }

  .pd-meta { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
  .pd-prefix { font-family: var(--font-mono); font-size: 13px; color: var(--text-muted); }
  /* 34px is the "Roomy" heading size Hassan picked; .cx-display-3 is 36. */
  .pd-title { margin-top: 8px; font-size: 34px; }
  .pd-subtitle { margin-top: 7px; font-size: var(--t-body-lg-size); line-height: 1.45; color: var(--text-body); }
  /* Under the photo, not beside the specs: the left column has the room, and
   keeping prose out of the right column is what lets the quote button stay
   above the fold once every product carries a description. */
  .pd-summary { margin-top: 14px; font-size: var(--t-body-size); line-height: 1.55;
    color: var(--text-body); max-width: 62ch; }
  .pd-specs { margin-top: 14px; }
  /* scoped, not global: .cx-spec is shared with the quote page */
  .pd-specs :global(.cx-spec dt) { padding-top: 6px; padding-bottom: 6px; }
  .pd-specs :global(.cx-spec dd) { padding-top: 6px; padding-bottom: 6px; }
  .pd-cta { display: flex; align-items: center; gap: 18px; margin-top: 14px; flex-wrap: wrap; }
  .pd-onrequest { margin: 0; flex: 1 1 15rem; font-size: 12px; line-height: 1.4;
    color: var(--text-muted); max-width: 36ch; }

  /* ---- Sizes panel: small, beside the photo, three rows then an expander.
     "Roomy" spacing, chosen from _spec-sheet-final.html. ---- */
  .pd-panel { margin-top: 14px; border: 1px solid var(--border-hairline); border-radius: var(--r-2);
    background: var(--surface-card); }
  .pd-panel__head { display: flex; align-items: baseline; gap: 9px; padding: 8px 15px;
    border-bottom: 1px solid var(--border-hairline); }
  .pd-panel__head h2 { font-family: var(--font-display); font-size: 14.5px; font-weight: var(--fw-bold);
    color: var(--text-strong); margin: 0; letter-spacing: -.005em; }
  .pd-panel__n { font-family: var(--font-mono); font-size: 12px; color: var(--text-muted); }
  /* The article-number total, named rather than left to be inferred from the
     row count — "Sizes 20" and "40 article numbers" are both true of a tray
     printed in two corner patterns. */
  .pd-panel__also { font-size: 11.5px; color: var(--text-faint); }
  .pd-panel__also::before { content: "· "; }
  .pd-panel__unit { margin-left: auto; font-size: 10.5px; letter-spacing: .1em; text-transform: uppercase;
    color: var(--text-faint); }
  .pd-panel .pd-sizes + .pd-sizes { margin-top: 0; border-top: 1px solid var(--border-hairline); }
  .pd-panel .pd-tablewrap { border: none; border-radius: 0; }
  /* A banded heading, not a floating line: with the tray list and the lid list
     stacked in one panel it has to be obvious where one ends and the next
     begins. Hassan, 2026-09-15: "2 box overlap of tray and lid". */
  .pd-panel .pd-h3 { padding: 9px 15px; margin: 0;
    background: var(--surface-sunken); border-bottom: 1px solid var(--border-hairline);
    font-size: 13px; letter-spacing: .01em; }
  .pd-panel .pd-table th { padding: 6px 15px; }
  .pd-panel .pd-table td { padding: 6px 15px; }
  .pd-panel .pd-more { width: 100%; margin: 0; border: none; border-top: 1px solid var(--border-hairline);
    border-radius: 0; padding: 9px 15px; text-align: left; color: var(--text-link); font-weight: var(--fw-medium); }
  .pd-panel .pd-note { padding: 0 15px 9px; margin-top: 6px; }

  .pd-block { margin-top: 48px; }
  .pd-group { border-top: 1px solid var(--border-hairline); padding-top: 32px; }
  .pd-group__grid { display: grid; grid-template-columns: minmax(0, 320px) minmax(0, 1fr); gap: 40px; align-items: start; }
  /* Block photos are smaller than the hero but follow the same rule: one size,
     set here rather than inherited from whatever shape the photo happens to be. */
  .pd-slider--sm .pd-figure { height: 300px; padding: 16px; }

  /* A set whose members are separate products (PRF surgical set) — each
     instrument gets its own block, framed upright the way the catalogue
     prints it, with whatever name and spec the catalogue actually carries. */
  .pd-grid--intro { grid-template-columns: minmax(0, 1fr); max-width: 62ch; }
  /* auto-fit, not auto-fill: the spare track collapses so a set of seven sits
     in one row across, the way the catalogue prints it. */
  /* auto-fit with a 1fr max let two items stretch to half the page each — a
     560px tower for one instrument. Cap the track so cards stay card-sized. */
  .pd-inst__grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(120px, 190px));
    gap: 18px; justify-content: start; }
  .pd-inst__item { margin: 0; border: 1px solid var(--border-hairline); border-radius: var(--r-2);
    padding: 14px 14px 16px; transition: border-color var(--dur-2) var(--ease-out); }
  .pd-inst__item:hover { border-color: var(--border-default); }
  /* Square by default. The 3/8 tower was drawn for the PRF set's long
     upright elevators; on a tray or a bedpan it strands the photo in a
     column of empty grey. */
  .pd-inst__frame { background: var(--surface-card); border-radius: var(--r-1); aspect-ratio: 1 / 1;
    display: flex; align-items: center; justify-content: center; padding: 12px 6px; }
  .pd-inst--tall .pd-inst__frame { aspect-ratio: 3 / 8; }
  .pd-inst__frame img { max-width: 100%; max-height: 100%; width: 100%; height: 100%; object-fit: contain; }
  .pd-inst--tall .pd-inst__frame img { width: auto; }
  .pd-inst__item figcaption { margin-top: 12px; display: flex; flex-direction: column; gap: 3px; }
  .pd-inst__name { font-family: var(--font-display); font-size: 13.5px; font-weight: var(--fw-semibold);
    color: var(--text-strong); margin: 0; line-height: 1.3; }
  .pd-inst__code { font-family: var(--font-mono); font-size: 12px; color: var(--text-muted); }
  .pd-inst__note { font-size: 12px; line-height: 1.4; color: var(--text-muted); }

  .pd-h2 { font-family: var(--font-display); font-size: 20px; font-weight: var(--fw-bold); color: var(--text-strong); margin: 0 0 18px; letter-spacing: -.01em; }
  .pd-h3 { font-family: var(--font-display); font-size: 14px; font-weight: var(--fw-semibold); color: var(--text-strong); margin: 0 0 10px; }
  .pd-count { font-family: var(--font-mono); font-size: 13px; font-weight: 400; color: var(--text-muted); margin-left: 6px; }

  .pd-sizes + .pd-sizes { margin-top: 30px; }
  /* min-width:0 here too: without it the wrapper reports the table's full
     min-content upward and the overflow-x never engages. */
  .pd-tablewrap { overflow-x: auto; min-width: 0; border: 1px solid var(--border-hairline); border-radius: var(--r-2); }
  /* The sizes panel, the sliders and the tables all sit inside a grid track and
     all carry content wider than a phone. Any one of them left at the default
     min-width:auto reopens H-07 on the pages that use it. */
  .pd-panel, .pd-panel__wrap, .pd-sizes, .pd-slider, .pd-figure, .pd-group, .pd-meta { min-width: 0; }
  .pd-table { width: 100%; border-collapse: collapse; font-size: 13.5px; }
  .pd-table th { text-align: left; font-family: var(--font-sans); font-size: 11px; letter-spacing: .1em; text-transform: uppercase;
    font-weight: var(--fw-semibold); color: var(--text-muted); padding: 12px 16px; border-bottom: 1px solid var(--border-default); white-space: nowrap; }
  .pd-table td { padding: 11px 16px; border-bottom: 1px solid var(--border-hairline); color: var(--text-body); }
  .pd-table tr:last-child td { border-bottom: none; }
  .pd-table .mono { font-family: var(--font-mono); font-size: 12.5px; color: var(--text-strong); white-space: nowrap; }

  [data-sizes]:not(.is-open) .pd-row--extra { display: none; }
  /* Expanded means expanded. The old rule capped each sub-table at 176px and
     gave it its own scrollbar, so the tray list and the lid list ran into each
     other and you had to scroll two boxes inside one panel to read a list the
     page had plenty of room for. Hassan, 2026-09-15: open it fully, all at
     once, as one vertical list. */

  /* Row numbers down the left edge. The header cell is labelled for screen
     readers only — a visible "#" adds nothing a sighted reader can't see. */
  .pd-sr { position: absolute; width: 1px; height: 1px; overflow: hidden;
    clip-path: inset(50%); white-space: nowrap; }
  .pd-table .pd-idx { width: 1%; white-space: nowrap; text-align: right;
    font-family: var(--font-mono); font-size: 11.5px; color: var(--text-faint);
    padding-right: 4px; }
  .pd-panel .pd-table th.pd-idx, .pd-panel .pd-table td.pd-idx { padding-left: 15px; }
  .pd-more { margin-top: 12px; background: none; border: 1px solid var(--border-default); border-radius: 999px;
    padding: 8px 18px; font-family: var(--font-sans); font-size: 13px; color: var(--text-body); cursor: pointer;
    transition: background var(--dur-2) var(--ease-out), border-color var(--dur-2) var(--ease-out); }
  .pd-more:hover { background: var(--surface-sunken); border-color: var(--brand-teal); color: var(--text-strong); }

  .pd-note { margin-top: 12px; font-size: 12.5px; color: var(--text-muted); }

  @media (prefers-reduced-motion: reduce) { .pd-more, .pd-arrow, .pd-dot { transition: none; } }
  @media (max-width: 860px) {
    .pd-grid { grid-template-columns: 1fr; gap: 32px; }
    .pd-group__grid { grid-template-columns: 1fr; gap: 24px; }
    .pd-inst__grid { grid-template-columns: repeat(4, 1fr); }
  }
  /* Mobile, approved 2026-09-14. Back link was 80x21. */
  @media (max-width: 820px) {
    .pd-back { min-height: 44px; }
    .pd-panel, .pd-panel__wrap, .pd-sizes { min-width: 0; }
    .pd-panel__unit, .pd-table th, .pd-panel__also, .pd-table .pd-idx { font-size: 12px; }
    /* Nothing visible under 12px on a phone. */
    .pd-thumb figcaption { font-size: 12px; }
    .pd-grid, .pd-group__grid { min-width: 0; }
  }
  @media (max-width: 520px) {
    .pd-thumbs { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .pd-inst__grid { grid-template-columns: repeat(2, 1fr); }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>("[data-slider]").forEach((box) => {
    const shots = [...box.querySelectorAll<HTMLImageElement>("[data-shot]")];
    const dots = [...box.querySelectorAll<HTMLButtonElement>("[data-dot]")];
    if (shots.length < 2) return;
    let i = 0;
    const show = (n: number) => {
      i = (n + shots.length) % shots.length;
      shots.forEach((img, k) => { img.hidden = k !== i; });
      dots.forEach((d, k) => d.classList.toggle("is-on", k === i));
    };
    box.querySelector("[data-prev]")?.addEventListener("click", () => show(i - 1));
    box.querySelector("[data-next]")?.addEventListener("click", () => show(i + 1));
    dots.forEach((d, k) => d.addEventListener("click", () => show(k)));
    show(0);
  });

  /* Click the hero photo to read the printed dimensions at full size. */
  const box = document.querySelector<HTMLElement>("[data-lightbox]");
  const big = document.querySelector<HTMLImageElement>("[data-lightbox-img]");
  if (box && big) {
    /* Carry the source image's alt and its real size across, so the enlarged
       view is described the same way and reserves its box (audit M-06). */
    const open = (src: string, alt: string, w: number, h: number) => {
      big.src = src;
      big.alt = alt;
      if (w && h) { big.width = w; big.height = h; }
      box.hidden = false;
      document.body.style.overflow = "hidden";
    };
    const shut = () => { box.hidden = true; box.classList.remove("is-full"); big.removeAttribute("src"); big.alt = ""; document.body.style.overflow = ""; };
    /* Only offer "enlarge" where enlarging shows more than the page already
       does. Measured against the rendered box, once the image has decoded. */
    const hint = document.querySelector<HTMLElement>("[data-zoomhint]");
    const zoomWorthwhile = (fig: HTMLElement) => {
      const img = fig.querySelector<HTMLImageElement>("[data-shot]:not([hidden])") ||
                  fig.querySelector<HTMLImageElement>("img");
      if (!img || !img.naturalWidth) return false;
      return img.naturalWidth >= img.getBoundingClientRect().width * 1.25;
    };
    const gradeZoom = () => {
      let any = false;
      document.querySelectorAll<HTMLElement>("[data-zoom]").forEach((fig) => {
        const ok = zoomWorthwhile(fig);
        fig.classList.toggle("pd-figure--zoom", ok);
        if (ok) any = true;
      });
      if (hint) hint.hidden = !any;
    };
    const firstShot = document.querySelector<HTMLImageElement>("[data-zoom] img");
    if (firstShot?.complete) gradeZoom();
    else firstShot?.addEventListener("load", gradeZoom, { once: true });
    addEventListener("resize", gradeZoom, { passive: true });

    document.querySelectorAll<HTMLElement>("[data-zoom]").forEach((fig) =>
      fig.addEventListener("click", () => {
        const shown = fig.querySelector<HTMLImageElement>("[data-shot]:not([hidden])") ||
                      fig.querySelector<HTMLImageElement>("img");
        if (!zoomWorthwhile(fig)) return;
        if (shown?.src) open(shown.src, shown.alt || "", shown.naturalWidth, shown.naturalHeight);
      }));
    const scale = box.querySelector<HTMLElement>("[data-scale]");
    const readout = () => {
      if (!scale) return;
      const pct = Math.round((big.getBoundingClientRect().width / big.naturalWidth) * 100);
      scale.textContent = box.classList.contains("is-full")
        ? `${pct}% — full size, drag to pan · click to fit`
        : `${pct}% — click the drawing for full size`;
    };
    big.addEventListener("click", (e) => {
      e.stopPropagation();                 // don't let the backdrop close it
      box.classList.toggle("is-full");
      readout();
    });
    box.addEventListener("click", shut);
    addEventListener("keydown", (e) => { if (e.key === "Escape" && !box.hidden) shut(); });
    big.addEventListener("load", readout);
  }

  document.querySelectorAll<HTMLElement>("[data-sizes]").forEach((wrap) => {
    const btn = wrap.querySelector<HTMLButtonElement>("[data-more]");
    if (!btn) return;
    const showLabel = btn.dataset.label || "Show all sizes";
    btn.addEventListener("click", () => {
      const open = wrap.classList.toggle("is-open");
      btn.textContent = open ? "Show fewer" : showLabel;
    });
  });
</script>
