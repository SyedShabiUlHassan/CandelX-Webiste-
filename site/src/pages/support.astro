---
/* Support — the design system's "Back Cover" page archetype (Layout & Data Rules §1).
   Contact details only, no invented copy (§6). Rule §5: the source catalogue's contact block
   carries the previous brand's details — those must NEVER appear here. CandelX values only.

   Audit 2026-09-14 (B-03): the two internal reminder blocks that used to sit on this page
   were printed to customers. They are gone. The outstanding work they described is tracked
   in DESIGN-DECISIONS.md and in src/data/site.ts, where the real values go. */
import Site from "../layouts/Site.astro";
import Section from "../components/ds/Section.astro";
import Eyebrow from "../components/ds/Eyebrow.astro";
import Button from "../components/ds/Button.astro";
import { CONTACT, TITLE_SUFFIX } from "../data/site.ts";

/* Rule §4: a value we do not hold renders as an em dash, never blank, and never invented.
   Fill these in at src/data/site.ts — they must be CandelX's own. */
const dash = (v: string) => (v && v.trim() ? v : "—");

const contact: [string, string][] = [
  ["Telephone", dash(CONTACT.telephone)],
  ["Email", dash(CONTACT.email)],
  ["Website", "candelxsurgicals.com"],
  ["Address", `${CONTACT.addressLocality}, Pakistan`],
];

/* What a useful enquiry carries. Written for the buyer, not for us — these are the
   four things that decide whether a quote can be returned same-day. */
const include = [
  ["Article numbers, or the product name", "Straight from the catalogue — CXMT-0508, or “wire mesh tray, single frame”."],
  ["Quantity per line", "Even a rough figure changes the price band."],
  ["Destination country and port", "It sets the packing, the paperwork and the freight."],
  ["Any drawing or sample", "For a custom footprint, a dimensioned sketch is enough to start."],
];
---

<Site
  current="support"
  title={`Contact and support${TITLE_SUFFIX}`}
  description="Contact CandelX Surgicals in Sialkot, Pakistan for sterilization containers, instrument trays and custom tray footprints. Send an enquiry or request a quote."
>
  <Section pad={80}>
    <Eyebrow>Support</Eyebrow>
    <h1 class="cx-display-3" style="margin-top:16px">Contact</h1>
    <p class="cx-body-lg" style="margin-top:18px;max-width:56ch;color:var(--text-body)">
      Send us the article numbers and quantities and we will come back with a quotation,
      lead time and packing detail.
    </p>

    <div class="sup">
      <div>
        <dl class="cx-spec">
          {contact.map(([k, v]) => (<><dt>{k}</dt><dd class={v === "—" ? "" : "plain"}>{v}</dd></>))}
        </dl>
        <div class="sup__cta">
          <Button href="/quote">Request a quote</Button>
          <a class="sup__faq" href="/faq">Read the FAQ</a>
        </div>
      </div>

      <div>
        <h2 class="cx-h3">What to include</h2>
        <dl class="sup__list">
          {include.map(([t, b]) => (
            <>
              <dt>{t}</dt>
              <dd>{b}</dd>
            </>
          ))}
        </dl>
      </div>
    </div>
  </Section>
</Site>

<style>
  .sup { display: grid; grid-template-columns: 1fr 1fr; gap: var(--s-12);
    margin-top: var(--s-10); max-width: 900px; align-items: start; }
  .sup__list { margin: var(--s-5) 0 0; display: flex; flex-direction: column; gap: var(--s-4); }
  .sup__list dt { font-weight: var(--fw-semibold); color: var(--text-strong); font-size: 14.5px; }
  .sup__list dd { margin: 3px 0 0; color: var(--text-muted); font-size: 14px; max-width: 44ch; }
  .sup__cta { margin-top: var(--s-7); display: flex; align-items: center; gap: var(--s-6); flex-wrap: wrap; }
  .sup__faq { display: inline-flex; align-items: center; min-height: 44px; font-size: 14.5px; }
  @media (max-width: 820px) { .sup { grid-template-columns: 1fr; gap: var(--s-8); } }
</style>
