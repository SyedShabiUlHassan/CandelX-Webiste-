---
/* Site footer — "colophon", chosen by Hassan 2026-09-14 (see DESIGN-DECISIONS.md).
 *
 * It carries NO navigation, deliberately. The previous footer was a 407px
 * four-column sitemap whose every link — Products, Quality, Capabilities,
 * Contact, Request a quote — is already in the header (audit H-10 put them
 * there). Repeating the header in a darker bar bought height and nothing else.
 *
 * What is left is the part the header cannot say: what the company makes, where,
 * since when, how far it ships, and the certifications. All of it is read from
 * data, never written here:
 *   · facts          → src/data/site.ts
 *   · certifications → src/data/certifications.ts (design-system rule §3: the
 *                      NAMES belong in the footer, the mark artwork only on /quality)
 *
 * Do not reintroduce a link list here without checking it against Header.astro
 * first. If the catalogue's filtered section views ever need a home below the
 * fold, variant A2 in the design-decisions log is the version that had them.
 */
import { certificationLine } from "../data/certifications.ts";
import { BRAND_FULL, CONTACT, FOUNDED, COUNTRIES } from "../data/site.ts";

const year = new Date().getFullYear();
---
<footer class="cx-footer">
  <div class="cx-container cx-footer__in">
    <a class="cx-footer__mark" href="/" aria-label={`${BRAND_FULL} — home`}>
      <img src="/brand/logo-candelx-white.png" alt={BRAND_FULL}
           width="98" height="24" loading="lazy" decoding="async" />
    </a>
    <p class="cx-footer__fact">
      {/* Keep each expression on the line of the word before it — Astro trims the
          whitespace at a line break, which silently produced "manufactured inSialkot". */}
      Sterilization containers and instrument trays, manufactured in {CONTACT.addressLocality}, Pakistan
      since {FOUNDED}. Supplied to {COUNTRIES} countries.
    </p>
  </div>
  <div class="cx-container cx-footer__legal">
    <span>© {year} {BRAND_FULL}</span>
    <a href="/privacy">Privacy</a>
    <a class="cx-footer__certs" href="/quality">{certificationLine}</a>
  </div>
</footer>
